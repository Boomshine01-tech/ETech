@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (isLoading)
{
    <div class="auth-loading">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Vérification...</span>
        </div>
        <p>Vérification de l'authentification...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="auth-error">
        <i class="fas fa-lock fa-3x"></i>
        <h3>Accès restreint</h3>
        <p>Vous devez être connecté pour accéder à cette page.</p>
        <a href="/login" class="btn btn-primary">Se connecter</a>
    </div>
}
else if (!isAuthorized)
{
    <div class="auth-error">
        <i class="fas fa-ban fa-3x"></i>
        <h3>Accès refusé</h3>
        <p>Vous n'avez pas les permissions nécessaires pour accéder à cette page.</p>
        <p class="debug-info">Rôle requis: Admin | Votre rôle: @currentRole</p>
        <a href="/" class="btn btn-secondary">Retour à l'accueil</a>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool RequireAdmin { get; set; } = false;

    private bool isAuthenticated = false;
    private bool isAuthorized = false;
    private bool isLoading = true;
    private string? currentRole;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthentication();
    }

    private async Task CheckAuthentication()
    {
        isLoading = true;

        try
        {
            Console.WriteLine(" AuthGuard - Vérification de l'authentification...");
            
            var token = await AuthService.GetTokenAsync();
            Console.WriteLine($"   Token présent: {!string.IsNullOrEmpty(token)}");
            
            if (string.IsNullOrEmpty(token))
            {
                Console.WriteLine("❌ Aucun token trouvé");
                isAuthenticated = false;
                isAuthorized = false;
                isLoading = false;
                
                await Task.Delay(100); // éviter navigation probleme
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            Console.WriteLine($"   Authentifié: {isAuthenticated}");

            if (!isAuthenticated)
            {
                Console.WriteLine("❌ Utilisateur non authentifié");
                isAuthorized = false;
                isLoading = false;
                
                await Task.Delay(100);
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            var (username, email, role) = await AuthService.GetCurrentUserAsync();
            currentRole = role;
            Console.WriteLine($"   Username: {username}");
            Console.WriteLine($"   Role: {role}");

            if (RequireAdmin)
            {
                var isAdmin = await AuthService.IsAdminAsync();
                Console.WriteLine($"   Admin requis: {RequireAdmin}");
                Console.WriteLine($"   Est Admin: {isAdmin}");
                isAuthorized = isAdmin;
                
                if (!isAuthorized)
                {
                    Console.WriteLine($"❌ Accès refusé - Rôle requis: Admin, Rôle actuel: {role}");
                }
                else
                {
                    Console.WriteLine("✅ Accès autorisé - Utilisateur est Admin");
                }
            }
            else
            {
                isAuthorized = true;
                Console.WriteLine("✅ Accès autorisé - Aucun rôle spécifique requis");
            }

            if (isAuthenticated && isAuthorized)
            {
                Console.WriteLine("✅ AuthGuard - Authentification et autorisation réussies");
            }
            else if (isAuthenticated && !isAuthorized)
            {
                Console.WriteLine("⚠️ AuthGuard - Authentifié mais pas autorisé");
                // Afficher le message d'erreur, ne pas rediriger
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erreur AuthGuard: {ex.Message}");
            Console.WriteLine($"   Stack: {ex.StackTrace}");
            isAuthenticated = false;
            isAuthorized = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

<style>
    .auth-loading, .auth-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 40px 20px;
        text-align: center;
    }

    .auth-loading p {
        margin-top: 20px;
        color: #6b7280;
    }

    .auth-error i {
        color: #3b82f6;
        margin-bottom: 20px;
    }

    .auth-error h3 {
        color: #1e3a8a;
        margin-bottom: 10px;
    }

    .auth-error p {
        color: #6b7280;
        margin-bottom: 20px;
    }

    .debug-info {
        font-size: 0.9rem;
        font-family: monospace;
        background: #f3f4f6;
        padding: 10px;
        border-radius: 5px;
        color: #dc2626;
    }

    .btn {
        padding: 12px 30px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: #3b82f6;
        color: white;
    }

    .btn-primary:hover {
        background: #2563eb;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: #6b7280;
        color: white;
    }

    .btn-secondary:hover {
        background: #4b5563;
    }

    .spinner-border {
        width: 50px;
        height: 50px;
        border: 4px solid #e5e7eb;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
