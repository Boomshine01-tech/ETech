@* Header unifié transparent pour toutes les pages *@

<div class="unified-header">
    <div class="header-background">
        <div class="header-grid-pattern"></div>
        <div class="header-floating-elements">
            <div class="floating-text tech-text">TECH</div>
            <div class="floating-text energy-text">ENERGY</div>
            <div class="floating-text plus-text">+</div>
        </div>
        <div class="header-particles">
            <div class="particle" style="--delay: 0s; --duration: 15s;"></div>
            <div class="particle" style="--delay: 2s; --duration: 12s;"></div>
            <div class="particle" style="--delay: 4s; --duration: 18s;"></div>
            <div class="particle" style="--delay: 6s; --duration: 14s;"></div>
            <div class="particle" style="--delay: 8s; --duration: 16s;"></div>
        </div>
    </div>
    
    <div class="header-content">
        <div class="container">
            <div class="header-badge">
                <i class="fas @BadgeIcon"></i>
                @BadgeText
            </div>
            <h1 class="header-title">
                @Title
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <br /><em class="header-subtitle">@Subtitle</em>
                }
            </h1>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="header-description">@Description</p>
            }
            
            @if (ShowStats)
            {
                <div class="header-stats">
                    <div class="stat-item">
                        <span class="stat-number">200+</span>
                        <span class="stat-label">Clients satisfaits</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-number">5+</span>
                        <span class="stat-label">Années d'expérience</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-number">50+</span>
                        <span class="stat-label">Projets réalisés</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";
    
    [Parameter]
    public string? Subtitle { get; set; }
    
    [Parameter]
    public string? Description { get; set; }
    
    [Parameter]
    public string BadgeIcon { get; set; } = "fa-bolt";
    
    [Parameter]
    public string BadgeText { get; set; } = "Excellence Technique";
    
    [Parameter]
    public bool ShowStats { get; set; } = false;
}

<style>
/* ═══════════════════════════════════════════════════════════════
   UNIFIED HEADER - DESIGN TRANSPARENT AVEC ÉLÉMENTS DE FOND
═══════════════════════════════════════════════════════════════ */
:root {
    --header-blue: #1e3a8a;
    --header-blue-light: #2563eb;
    --header-blue-mid: #3b82f6;
    --header-gold: #fbbf24;
    --header-gold-dark: #f59e0b;
    --header-ink: #0f1923;
    --header-white: #ffffff;
}

.unified-header {
    position: relative;
    background: linear-gradient(135deg, 
        rgba(30, 58, 138, 0.45) 0%, 
        rgba(37, 99, 235, 0.35) 60%, 
        rgba(59, 130, 246, 0.25) 100%);
    color: var(--header-white);
    padding: 120px 20px 80px;
    text-align: center;
    overflow: hidden;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    animation: headerFloat 8s ease-in-out infinite;
}

/* Fond avec grille transparente */
.header-background {
    position: absolute;
    inset: 0;
    z-index: 1;
}

.header-grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.6;
}

/* Textes flottants en arrière-plan */
.header-floating-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
}

.floating-text {
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 800;
    opacity: 0.08;
    user-select: none;
    animation: floatSlow 20s ease-in-out infinite;
}

.tech-text {
    font-size: 18rem;
    top: -5%;
    left: -10%;
    color: var(--header-gold);
    animation-delay: 0s;
}

.energy-text {
    font-size: 22rem;
    bottom: -8%;
    right: -5%;
    color: var(--header-white);
    animation-delay: 5s;
}

.plus-text {
    font-size: 12rem;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--header-gold);
    animation-delay: 10s;
}

@@keyframes floatSlow {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-20px) rotate(2deg); }
    50% { transform: translateY(10px) rotate(-1deg); }
    75% { transform: translateY(-15px) rotate(1deg); }
}

/* Particules animées */
.header-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
}

.particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--header-gold);
    border-radius: 50%;
    opacity: 0.6;
    animation: floatUp var(--duration) linear infinite;
    animation-delay: var(--delay);
}

@@keyframes floatUp {
    0% {
        transform: translateY(100vh) translateX(0);
        opacity: 0;
    }
    10% {
        opacity: 0.6;
    }
    90% {
        opacity: 0.6;
    }
    100% {
        transform: translateY(-100px) translateX(100px);
        opacity: 0;
    }
}

/* Contenu principal */
.header-content {
    position: relative;
    z-index: 10;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

.header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, 
        rgba(251, 191, 36, 0.15) 0%, 
        rgba(251, 191, 36, 0.25) 100%);
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: var(--header-gold);
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    animation: slideInFromLeft 0.8s ease both, shimmer 3s ease-in-out infinite;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    position: relative;
    overflow: hidden;
}

.header-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
        transparent, 
        rgba(255, 255, 255, 0.2), 
        transparent);
    animation: shimmer 3s infinite;
}

.header-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1.2rem;
    animation: slideInFromRight 0.8s ease 0.1s both, pulse 4s ease-in-out infinite 0.5s;
    line-height: 1.1;
    background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
}

.header-subtitle {
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    color: var(--header-gold);
    display: block;
    animation: fadeUp 0.6s ease 0.2s both, pulse 3s ease-in-out infinite 1s;
    text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);
}

.header-description {
    font-size: 1.1rem;
    opacity: 0.95;
    max-width: 700px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
    animation: slideInFromLeft 0.8s ease 0.3s both;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
}

/* Statistiques */
.header-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, 
        rgba(255, 255, 255, 0.05) 0%, 
        rgba(255, 255, 255, 0.15) 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 1.5rem 2rem;
    max-width: 600px;
    margin: 0 auto;
    animation: fadeUp 0.8s ease 0.3s both, pulse 5s ease-in-out infinite 2s;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
}

.header-stats::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, 
        transparent, 
        rgba(255, 255, 255, 0.1), 
        transparent);
    animation: shimmer 4s infinite;
}

.stat-item {
    flex: 1;
    text-align: center;
    position: relative;
    z-index: 2;
    transition: transform 0.3s ease;
}

.stat-item:hover {
    transform: translateY(-5px) scale(1.05);
}

.stat-number {
    display: block;
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--header-gold);
    text-shadow: 0 0 20px rgba(251, 191, 36, 0.5);
    transition: all 0.3s ease;
}

.stat-item:hover .stat-number {
    text-shadow: 0 0 30px rgba(251, 191, 36, 0.8);
    transform: scale(1.1);
}

.stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.2rem;
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: all 0.3s ease;
}

.stat-item:hover .stat-label {
    color: rgba(255, 255, 255, 1);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

.stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, 
        transparent, 
        rgba(255, 255, 255, 0.3), 
        transparent);
    flex-shrink: 0;
    margin: 0 1.5rem;
    animation: pulse 2s infinite;
}

/* Animations modernes */
@@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(24px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes headerFloat {
    0%, 100% {
        transform: translateY(0px);
        background: linear-gradient(135deg, 
            rgba(30, 58, 138, 0.45) 0%, 
            rgba(37, 99, 235, 0.35) 60%, 
            rgba(59, 130, 246, 0.25) 100%);
    }
    50% {
        transform: translateY(-10px);
        background: linear-gradient(135deg, 
            rgba(30, 58, 138, 0.55) 0%, 
            rgba(37, 99, 235, 0.45) 60%, 
            rgba(59, 130, 246, 0.35) 100%);
    }
}

@@keyframes slideInFromLeft {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@@keyframes slideInFromRight {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@@keyframes pulse {
    0%, 100% {
        transform: scale(1);
        opacity: 1;
    }
    50% {
        transform: scale(1.05);
        opacity: 0.8;
    }
}

@@keyframes shimmer {
    0% {
        background-position: -1000px 0;
    }
    100% {
        background-position: 1000px 0;
    }
}

/* Responsive */
@@media (max-width: 768px) {
    .unified-header {
        padding: 80px 20px 60px;
    }
    
    .tech-text {
        font-size: 10rem;
        top: -3%;
        left: -5%;
    }
    
    .energy-text {
        font-size: 12rem;
        bottom: -5%;
        right: -3%;
    }
    
    .plus-text {
        font-size: 8rem;
    }
    
    .header-stats {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }
    
    .stat-divider {
        width: 40px;
        height: 1px;
        margin: 0.5rem auto;
    }
}

@@media (max-width: 480px) {
    .tech-text {
        font-size: 6rem;
    }
    
    .energy-text {
        font-size: 8rem;
    }
    
    .plus-text {
        font-size: 5rem;
    }
}
</style>
