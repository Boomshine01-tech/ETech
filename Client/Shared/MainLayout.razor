@inherits LayoutComponentBase

<div class="page">
    <NavMenu />
    @if (showAnnouncement)
    {
        <div class="announcement-bar d-flex justify-content-between align-items-center px-3 py-1 bg-dark text-white text-center fs-7">
            <span class="w-100">💡 <strong>Offre Spéciale :</strong> Inscriptions ouvertes pour nos nouvelles formations d'énergie solaire !</span>
            <button class="btn-close btn-close-white ms-2" style="font-size: 0.7rem;" @onclick="DismissBanner"></button>
        </div>
    }

    <UnifiedHeader />
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
    <Footer />
</div>
@code {
    private bool showAnnouncement = true;

    private void DismissBanner() => showAnnouncement = false;
}

<script type="application/ld+json">
{
"context": "https://schema.org",
"type": "LocalBusiness",
"name": "e-Tech Energie+",
"image": "https://etechenergie.onrender.com/images/logo.png",
"url": "https://etechenergie.onrender.com",
"telephone": "+221 770467004",
"address": {
"type": "PostalAddress",
"addressLocality": "Thiès",
"addressCountry": "SN"
},
"description": "Entreprise spécialisée en énergie solaire, installation 
électrique et automatismes industriels et vente de materiel éléctronique au Sénégal"
}
</script>

<style>
    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex: 1;
    }

    .content {
        padding: 0;
    }

    .px-4 {
        padding-left: 0;
        padding-right: 0;
    }
</style>
