@page "/realisations"
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable
@using ETechEnergie.Shared.Models

<PageTitle>Nos Réalisations - e-Tech Energie+</PageTitle>
<HeadContent>
    <meta name="description" content="Découvrez les réalisations de e-Tech Energie+ : chantiers BTP, installations électriques, partenariats et projets réalisés à Thiès et au Sénégal." />
    <meta name="keywords" content="réalisations, chantiers, installations électriques, Thiès, Sénégal" />
    <meta property="og:title" content="Réalisations | e-Tech Energie+" />
    <meta property="og:url" content="https://etechenergie.onrender.com/realisations" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
</HeadContent>

<!-- ===== HEADER (bleu — inchangé) ===== -->
<div class="page-header">
    <div class="header-grid-bg"></div>
    <div class="container">
        <div class="header-badge"><i class="fas fa-hard-hat"></i> Notre Travail</div>
        <h1>Nos <span class="accent">Réalisations</span></h1>
        <p class="header-sub">
            Depuis notre création, e-Tech Energie+ a accompagné des particuliers, des entreprises et des institutions
            dans leurs projets techniques. Chaque chantier est une promesse tenue.
        </p>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-number">28+</span>
                <span class="stat-label">Projets réalisés</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">5+</span>
                <span class="stat-label">Années d'expérience</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">200+</span>
                <span class="stat-label">Clients satisfaits</span>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="rz-loading-state">
        <div class="rz-spinner"></div>
        <p>Chargement des réalisations...</p>
    </div>
}
else if (!sections.Any())
{
    <div class="rz-loading-state">
        <p>Aucune réalisation à afficher pour le moment.</p>
    </div>
}
else
{
    <!-- ===== NAV PILL ===== -->
    <div class="pill-nav-wrap">
        <nav class="pill-nav">
            @foreach (var s in sections)
            {
                <button class="pill @(activeSection == s.Slug ? "active" : "")" @onclick='() => ScrollTo(s.Slug)'>
                    <i class="fas @s.NavIcon"></i> @s.NavLabel
                </button>
            }
        </nav>
    </div>

    @for (var si = 0; si < sections.Count; si++)
    {
        var section = sections[si];
        var isDark = section.Theme == "dark";
        var prevIsDark = si > 0 && sections[si - 1].Theme == "dark";

        @if (si > 0 && !prevIsDark && isDark)
        {
            <!-- ===== DIVIDER (vers section sombre) ===== -->
            <div class="wave-divider">
                <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#0f1923" />
                </svg>
            </div>
        }
        @if (si > 0 && prevIsDark && !isDark)
        {
            <!-- ===== DIVIDER (sortie de section sombre) ===== -->
            <div class="wave-divider wave-up">
                <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0,30 C360,0 1080,60 1440,30 L1440,0 L0,0 Z" fill="#0f1923" />
                </svg>
            </div>
        }

        @if (section.Images.Any())
        {
            var images = section.Images.ToList();
            var curIdx = currentIndexBySection.TryGetValue(section.Id, out var ci) ? ci : 0;
            if (curIdx >= images.Count) { curIdx = 0; }
            var current = images[curIdx];

            RenderFragment imageSide =
                @<div class="hero-image-side">
                    <div class="hero-img-frame @FrameClass(section.Theme)" @onclick='() => OpenModal(section, curIdx)'>
                        <img src="@current.ImageUrl" alt="@current.Titre" class="hero-img hero-img-transition" />
                        <div class="hero-img-overlay">
                            <button class="zoom-btn @ZoomBtnClass(section.Theme)"><i class="fas fa-expand-arrows-alt"></i> Voir en grand</button>
                        </div>
                        <div class="img-counter-badge @BadgeClass(section.Theme)">
                            <span class="img-cur">@(curIdx + 1)</span>
                            <span class="img-sep">/</span>
                            <span class="img-tot">@images.Count</span>
                        </div>
                        <div class="progress-bar-wrap">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                var ii = i;
                                <div class="pb-seg @ProgressClass(section.Theme) @(ii == curIdx ? "active" : "")"
                                     @onclick:stopPropagation="true"
                                     @onclick='() => SetCurrentImage(section, ii)'></div>
                            }
                        </div>
                    </div>
                    <div class="hero-arrows">
                        <button class="arrow-btn @ArrowClass(section.Theme)" @onclick='() => StepImage(section, -1)'>
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <button class="arrow-btn @ArrowClass(section.Theme)" @onclick='() => StepImage(section, 1)'>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>;

            RenderFragment infoSide =
                @<div class="hero-info-side">
                    <div class="section-eyebrow @EyebrowClass(section.Theme)">
                        <span class="ey-line"></span>
                        <i class="fas @section.NavIcon"></i> @section.Eyebrow
                    </div>
                    <h2 class="section-title @TitleClass(section.Theme)">
                        @section.TitleMain<br /><em>@section.TitleAccent</em>
                    </h2>
                    <p class="section-body @BodyClass(section.Theme)">
                        @section.Body
                    </p>
                    <div class="project-card-info @PciClass(section.Theme)">
                        <div class="pci-label">@section.ProjectLabel</div>
                        <div class="pci-title">@current.Titre</div>
                        <div class="pci-loc"><i class="fas fa-map-marker-alt"></i> @current.Lieu</div>
                        @if (!string.IsNullOrEmpty(current.Description))
                        {
                            <div class="pci-desc">@current.Description</div>
                        }
                    </div>
                </div>;

            <section class="rz-section @(isDark ? "dark-section" : "")" id="@section.Slug">
                @if (isDark)
                {
                    <div class="dark-bg-deco"></div>
                }

                @if (section.ShowBadge)
                {
                    <div class="partner-hero">
                        <div class="partner-badge-float">
                            <i class="fas @(section.BadgeIcon ?? "fa-star")"></i>
                            <span>@section.BadgeLabel</span>
                            <strong>@section.BadgeHighlight</strong>
                        </div>

                        <div class="hero-split @(section.ReverseLayout ? "hero-split-reverse" : "")">
                            @if (section.ReverseLayout) { @infoSide @imageSide } else { @imageSide @infoSide }
                        </div>

                        <div class="thumb-strip-wrap">
                            <div class="thumb-strip">
                                @foreach (var item in images)
                                {
                                    var idx = images.IndexOf(item);
                                    <div class="ts-item @ThumbClass(section.Theme) @(idx == curIdx ? "ts-active" : "")"
                                         @onclick='() => SetCurrentImage(section, idx)'>
                                        <img src="@item.ImageUrl" alt="@item.Titre" loading="lazy" />
                                        <div class="ts-overlay"><span>@item.Titre</span></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hero-split @(section.ReverseLayout ? "hero-split-reverse" : "")">
                        @if (section.ReverseLayout) { @infoSide @imageSide } else { @imageSide @infoSide }
                    </div>

                    <div class="thumb-strip-wrap">
                        <div class="thumb-strip">
                            @foreach (var item in images)
                            {
                                var idx = images.IndexOf(item);
                                <div class="ts-item @ThumbClass(section.Theme) @(idx == curIdx ? "ts-active" : "")"
                                     @onclick='() => SetCurrentImage(section, idx)'>
                                    <img src="@item.ImageUrl" alt="@item.Titre" loading="lazy" />
                                    <div class="ts-overlay"><span>@item.Titre</span></div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        }
    }

    <!-- ===== CTA ===== -->
    <section class="cta-section">
        <div class="cta-inner">
            <div class="cta-deco-text">PROJET</div>
            <div class="cta-content">
                <h2>Vous avez un projet ?</h2>
                <p>Notre équipe est prête à étudier votre besoin.</p>
                <a href="/contact" class="cta-btn">
                    <span>Demander un devis</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- ===== MODAL ===== -->
    @if (showModal && modalSection != null && modalSection.Images.Any())
    {
        var modalImages = modalSection.Images.ToList();
        var selected = modalImages[modalIndex];

        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-shell" @onclick:stopPropagation="true">
                <button class="modal-x" @onclick="CloseModal"><i class="fas fa-times"></i></button>

                <button class="modal-side-btn left" @onclick="PrevImage" disabled="@(modalIndex == 0)">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="modal-side-btn right" @onclick="NextImage" disabled="@(modalIndex == modalImages.Count - 1)">
                    <i class="fas fa-chevron-right"></i>
                </button>

                <div class="modal-body">
                    <div class="modal-visual">
                        <img src="@selected.ImageUrl" alt="@selected.Titre" />
                    </div>
                    <div class="modal-panel">
                        <div class="mp-tag">
                            <i class="fas @modalSection.NavIcon"></i>
                            @modalSection.NavLabel
                        </div>
                        <h2 class="mp-title">@selected.Titre</h2>
                        <p class="mp-loc"><i class="fas fa-map-marker-alt"></i> @selected.Lieu</p>
                        @if (!string.IsNullOrEmpty(selected.Description))
                        {
                            <p class="mp-desc">@selected.Description</p>
                        }
                        <div class="mp-counter">@(modalIndex + 1) <em>/</em> @modalImages.Count</div>
                        <div class="mp-thumbs">
                            @foreach (var item in modalImages)
                            {
                                var idx = modalImages.IndexOf(item);
                                <div class="mp-thumb @(idx == modalIndex ? "mp-thumb-active" : "")"
                                     @onclick="() => SetModalImage(idx)">
                                    <img src="@item.ImageUrl" alt="@item.Titre" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<RealisationSection> sections = new();
    private Dictionary<int, int> currentIndexBySection = new();
    private bool isLoading = true;
    private string activeSection = "";

    private bool showModal = false;
    private RealisationSection? modalSection;
    private int modalIndex = 0;

    private System.Timers.Timer? autoTimer;

    // ── LIFECYCLE ────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            sections = await Http.GetFromJsonAsync<List<RealisationSection>>("api/realisations") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur de chargement des réalisations: {ex.Message}");
            sections = new();
        }

        foreach (var s in sections)
        {
            currentIndexBySection[s.Id] = 0;
        }
        activeSection = sections.FirstOrDefault()?.Slug ?? "";
        isLoading = false;

        if (sections.Any(s => s.Images.Any()))
        {
            autoTimer = new System.Timers.Timer(5000);
            autoTimer.Elapsed += (_, _) => InvokeAsync(() =>
            {
                foreach (var s in sections.Where(s => s.Images.Any()))
                {
                    currentIndexBySection[s.Id] = (currentIndexBySection[s.Id] + 1) % s.Images.Count;
                }
                StateHasChanged();
            });
            autoTimer.AutoReset = true;
            autoTimer.Enabled = true;
        }
    }

    public void Dispose() { autoTimer?.Stop(); autoTimer?.Dispose(); }

    // ── ACTIONS ──────────────────────────────────────────────────
    private void SetCurrentImage(RealisationSection section, int idx)
    {
        currentIndexBySection[section.Id] = idx;
        StateHasChanged();
    }

    private void StepImage(RealisationSection section, int dir)
    {
        var count = section.Images.Count;
        if (count == 0) return;
        var cur = currentIndexBySection.TryGetValue(section.Id, out var ci) ? ci : 0;
        var next = (cur + dir + count) % count;
        SetCurrentImage(section, next);
    }

    private async Task ScrollTo(string slug)
    {
        activeSection = slug;
        await JS.InvokeVoidAsync("scrollToSection", slug);
    }

    private void OpenModal(RealisationSection section, int idx)
    {
        modalSection = section;
        modalIndex = idx;
        showModal = true;
    }

    private void CloseModal() { showModal = false; modalSection = null; }

    private void PrevImage()
    {
        if (modalIndex > 0) { modalIndex--; }
    }

    private void NextImage()
    {
        if (modalSection != null && modalIndex < modalSection.Images.Count - 1) { modalIndex++; }
    }

    private void SetModalImage(int idx) { modalIndex = idx; }

    // ── THEME HELPERS ────────────────────────────────────────────
    // Chaque nouvelle section créée depuis l'administration réutilise l'un de ces 3 styles
    // déjà présents sur le site, ce qui garantit une architecture visuelle cohérente.
    private static string FrameClass(string theme)    => theme switch { "dark" => "elec-frame", "green" => "green-frame", _ => "" };
    private static string ZoomBtnClass(string theme)   => theme switch { "dark" => "zoom-btn-blue", "green" => "zoom-btn-green", _ => "" };
    private static string BadgeClass(string theme)     => theme switch { "dark" => "blue-badge", "green" => "green-badge", _ => "" };
    private static string ProgressClass(string theme)  => theme switch { "dark" => "pb-blue", "green" => "pb-green", _ => "" };
    private static string ThumbClass(string theme)     => theme switch { "dark" => "ts-blue", "green" => "ts-green", _ => "" };
    private static string ArrowClass(string theme)     => theme == "dark" ? "arrow-dark" : "";
    private static string EyebrowClass(string theme)   => theme switch { "blue" => "btp-ey", "dark" => "elec-ey", "green" => "part-ey", _ => "" };
    private static string TitleClass(string theme)     => theme == "dark" ? "light-title" : "";
    private static string BodyClass(string theme)      => theme == "dark" ? "light-body" : "";
    private static string PciClass(string theme)       => theme == "dark" ? "dark-pci" : "";
}

<style>
/* ═══════════════════════════════════════════════════════════════
   TOKENS
═══════════════════════════════════════════════════════════════ */
:root {
    --ink:      #0f1923;
    --ink2:     #1e2d3d;
    --soft:     #4a5c6e;
    --mist:     #f2f5f8;
    --gold:     #f5a623;
    --gold-lt:  #fde68a;
    --blue:     #1e3a8a;
    --blue-mid: #3b82f6;
    --green:    #10b981;
    --white:    #ffffff;
    --r:        12px;
    --r-lg:     20px;
    --font-h:   'Bebas Neue', sans-serif;
    --font-s:   'DM Serif Display', serif;
    --font-b:   'DM Sans', sans-serif;
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
body { font-family:var(--font-b); color:var(--ink); background:var(--white); }

/* ═══════════════════════════════════════════════════════════════
   HEADER (INCHANGÉ)
═══════════════════════════════════════════════════════════════ */
.page-header {
    background: linear-gradient(135deg,#1e3a8a 0%,#2563eb 60%,#3b82f6 100%);
    color:white; padding:90px 20px 70px;
    text-align:center; position:relative; overflow:hidden;
}
.header-grid-bg {
    position:absolute; inset:0;
    background-image:
        linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
    background-size:50px 50px;
}
.header-badge {
    display:inline-flex; align-items:center; gap:.5rem;
    background:rgba(251,191,36,.15); border:1px solid rgba(251,191,36,.4);
    color:#fbbf24; padding:.4rem 1.2rem; border-radius:50px;
    font-size:.78rem; font-weight:700; margin-bottom:1.5rem;
    animation:fadeUp .6s ease both;
}
.page-header h1 { font-size:clamp(2.2rem,5vw,3.8rem); font-weight:800; margin-bottom:1.2rem; animation:fadeUp .6s ease .1s both; }
.accent { color:#fbbf24; }
.header-sub { font-size:1rem; opacity:.78; max-width:640px; margin:0 auto 2.5rem; line-height:1.7; animation:fadeUp .6s ease .2s both; }
.header-stats { display:flex; justify-content:center; align-items:center; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:1.5rem 2rem; max-width:560px; margin:0 auto; animation:fadeUp .6s ease .3s both; }
.stat-item { flex:1; text-align:center; }
.stat-number { display:block; font-size:2.2rem; font-weight:800; color:#fbbf24; }
.stat-label  { font-size:.75rem; color:rgba(255,255,255,.6); margin-top:.2rem; display:block; }
.stat-divider { width:1px; height:40px; background:rgba(255,255,255,.2); flex-shrink:0; margin:0 .5rem; }

/* ═══════════════════════════════════════════════════════════════
   PILL NAV
═══════════════════════════════════════════════════════════════ */
.pill-nav-wrap {
    display:flex; justify-content:center;
    padding:1.5rem 1rem;
    background:var(--white);
    position:sticky; top:0; z-index:100;
    box-shadow:0 1px 0 rgba(0,0,0,.07);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}
.pill-nav { display:flex; gap:.6rem; background:var(--mist); padding:.35rem; border-radius:50px; }
.pill {
    display:inline-flex; align-items:center; gap:.5rem;
    padding:.55rem 1.4rem; border-radius:50px; border:none;
    background:transparent; color:var(--soft);
    font-family:var(--font-b); font-size:.82rem; font-weight:600;
    cursor:pointer; transition:all .3s; white-space:nowrap;
}
.pill i { font-size:.85rem; }
.pill:hover { color:var(--ink); background:rgba(255,255,255,.7); }
.pill.active { background:var(--ink); color:var(--gold); box-shadow:0 4px 16px rgba(15,25,35,.25); }

/* ═══════════════════════════════════════════════════════════════
   SECTIONS
═══════════════════════════════════════════════════════════════ */
.rz-section { padding:80px 0 60px; overflow:hidden; }
.dark-section { background:var(--ink); position:relative; }
.dark-bg-deco {
    position:absolute; inset:0;
    background-image:radial-gradient(circle at 80% 20%, rgba(59,130,246,.08) 0%, transparent 60%),
                     radial-gradient(circle at 10% 80%, rgba(245,166,35,.05) 0%, transparent 50%);
    pointer-events:none;
}

/* ═══════════════════════════════════════════════════════════════
   HERO SPLIT LAYOUT
═══════════════════════════════════════════════════════════════ */
.hero-split {
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:4rem;
    max-width:1200px;
    margin:0 auto;
    padding:0 40px;
    align-items:center;
}
.hero-split-reverse { direction:rtl; }
.hero-split-reverse > * { direction:ltr; }

/* IMAGE SIDE */
.hero-image-side { position:relative; }
.hero-img-frame {
    position:relative; border-radius:var(--r-lg);
    overflow:hidden; cursor:pointer;
    aspect-ratio:4/3;
    box-shadow:0 24px 64px rgba(15,25,35,.22);
    transition:box-shadow .4s;
}
.hero-img-frame:hover { box-shadow:0 32px 80px rgba(15,25,35,.3); }
.hero-img {
    width:100%; height:100%; object-fit:cover;
    transition:transform .7s cubic-bezier(.4,0,.2,1), opacity .5s;
    display:block;
}
.hero-img-frame:hover .hero-img { transform:scale(1.04); }
.hero-img-overlay {
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(10,18,40,.8) 0%, transparent 50%);
    display:flex; align-items:flex-end; justify-content:flex-start;
    padding:1.4rem;
    opacity:0; transition:opacity .35s;
}
.hero-img-frame:hover .hero-img-overlay { opacity:1; }

.zoom-btn {
    display:inline-flex; align-items:center; gap:.5rem;
    background:var(--gold); color:var(--ink);
    border:none; padding:.55rem 1.1rem; border-radius:50px;
    font-size:.76rem; font-weight:700; cursor:pointer;
    transition:transform .2s; font-family:var(--font-b);
    text-transform:uppercase; letter-spacing:.04em;
}
.zoom-btn:hover { transform:scale(1.05); }
.zoom-btn-blue  { background:var(--blue-mid); color:white; }
.zoom-btn-green { background:var(--green); color:white; }

.elec-frame  { box-shadow:0 24px 64px rgba(59,130,246,.18); }
.green-frame { box-shadow:0 24px 64px rgba(16,185,129,.18); }

/* COUNTER BADGE */
.img-counter-badge {
    position:absolute; top:14px; right:14px;
    background:rgba(10,18,40,.7); backdrop-filter:blur(8px);
    border:1px solid rgba(255,255,255,.15);
    color:white; border-radius:8px; padding:.3rem .7rem;
    font-family:var(--font-h); font-size:1rem; letter-spacing:.05em;
}
.img-cur { color:var(--gold); font-size:1.3rem; }
.img-sep { opacity:.5; margin:0 2px; }
.blue-badge  .img-cur { color:var(--blue-mid); }
.green-badge .img-cur { color:var(--green); }

/* PROGRESS BAR */
.progress-bar-wrap {
    position:absolute; bottom:0; left:0; right:0;
    display:flex; gap:3px; padding:0 12px 12px; z-index:5;
}
.pb-seg {
    flex:1; height:3px; background:rgba(255,255,255,.3);
    border-radius:2px; cursor:pointer; transition:all .3s;
}
.pb-seg.active       { background:var(--gold); height:4px; }
.pb-seg.pb-blue.active  { background:var(--blue-mid); }
.pb-seg.pb-green.active { background:var(--green); }

/* ARROW BUTTONS */
.hero-arrows {
    display:flex; gap:.6rem; margin-top:1rem; justify-content:flex-end;
}
.arrow-btn {
    width:44px; height:44px; border-radius:50%;
    background:var(--ink); border:none; color:var(--gold);
    font-size:.95rem; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:all .25s;
}
.arrow-btn:hover { background:var(--gold); color:var(--ink); transform:scale(1.08); }
.arrow-dark { background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); color:white; }
.arrow-dark:hover { background:var(--blue-mid); color:white; border-color:var(--blue-mid); }

/* INFO SIDE */
.hero-info-side { display:flex; flex-direction:column; gap:1.4rem; }

.section-eyebrow {
    display:inline-flex; align-items:center; gap:.7rem;
    font-size:.75rem; font-weight:700; text-transform:uppercase;
