@page "/formations"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Formations - e-Tech Energie+</PageTitle>
<HeadContent>
    <meta name="description" content="e-Tech Energie+ dispense des formations professionnelles à Thiès, Sénégal. Inscrivez-vous à nos formations en cours ou rejoignez la liste d'attente." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<!-- ===== HERO MORPHING ===== -->
<div class="hero-morphing">
    <canvas id="morphingCanvas"></canvas>
    <div class="hero-overlay"></div>
    
    <div class="hero-content">
        <div class="hero-badge floating-badge">
            <i class="fas fa-graduation-cap"></i> Formations Pro
            <div class="badge-ring"></div>
        </div>
        
        <h1 class="hero-title">
            <span class="title-word" data-text="Nos">Nos</span>
            <span class="title-word accent" data-text="Formations">Formations</span>
            <span class="title-word" data-text="Professionnelles">Professionnelles</span>
        </h1>
        
        @if (isLoading)
        {
            <div class="loading-spinner">
                <i class="fas fa-spinner fa-spin"></i> Chargement...
            </div>
        }
        else
        {
            <div class="header-stats">
                <div class="stat-item">
                    <span class="stat-number">@formationsEnCours.Count</span>
                    <span class="stat-label">En cours</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">@formationsAVenir.Count</span>
                    <span class="stat-label">À venir</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">@formationsTerminees.Count</span>
                    <span class="stat-label">Terminées</span>
                </div>
            </div>
        }
        
        <div class="hero-scroll">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <span>Explorer</span>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <div class="spinner"></div>
        <p>Chargement des formations...</p>
    </div>
}
else
{
    <!-- ===== FORMATIONS EN COURS ===== -->
@if (formationsEnCours.Any())
{
    <section class="formations-section">
        <div class="section-header">
            <div class="header-glow"><i class="fas fa-play-circle"></i> En cours</div>
            <h2>Formations <span class="gradient-text">en cours</span></h2>
            <div class="header-line"></div>
        </div>
        <div class="formations-grid">
            @foreach (var formation in formationsEnCours)
            {
                <div class="formation-card">
                    <div class="formation-header">
                        <span class="formation-status status-en-cours">En cours</span>
                        <span class="formation-price">@formation.Prix.ToString("N0") FCFA</span>
                    </div>
                    <h3>@formation.Titre</h3>
                    <p class="formation-desc">@formation.Description</p>
                    <div class="formation-details">
                        <div class="detail"><i class="fas fa-calendar"></i> @formation.DateDebut.ToString("dd/MM/yyyy") - @formation.DateFin.ToString("dd/MM/yyyy")</div>
                        <div class="detail"><i class="fas fa-clock"></i> @formation.Horaires</div>
                        <div class="detail"><i class="fas fa-map-marker-alt"></i> @formation.Lieu</div>
                        <div class="detail"><i class="fas fa-users"></i> @formation.PlacesRestantes / @formation.CapaciteMax places</div>
                    </div>
                    @if (formation.InscriptionOuverte && formation.PlacesRestantes > 0)
                    {
                        <button class="btn-formation btn-primary" @onclick="() => OpenInscriptionModal(formation)">
                            <i class="fas fa-user-plus"></i> S'inscrire
                        </button>
                    }
                    else
                    {
                        <button class="btn-formation btn-disabled" disabled>
                            <i class="fas fa-ban"></i> Inscriptions fermées
                        </button>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ===== FORMATIONS À VENIR ===== -->
@if (formationsAVenir.Any())
{
    <section class="formations-section alt-bg">
        <div class="section-header">
            <div class="header-glow"><i class="fas fa-calendar-plus"></i> À venir</div>
            <h2>Prochaines <span class="gradient-text">formations</span></h2>
            <div class="header-line"></div>
        </div>
        <div class="formations-grid">
            @foreach (var formation in formationsAVenir)
            {
                <div class="formation-card">
                    <div class="formation-header">
                        <span class="formation-status status-avenir">À venir</span>
                        <span class="formation-price">@formation.Prix.ToString("N0") FCFA</span>
                    </div>
                    <h3>@formation.Titre</h3>
                    <p class="formation-desc">@formation.Description</p>
                    <div class="formation-details">
                        <div class="detail"><i class="fas fa-calendar"></i> @formation.DateDebut.ToString("dd/MM/yyyy") - @formation.DateFin.ToString("dd/MM/yyyy")</div>
                        <div class="detail"><i class="fas fa-clock"></i> @formation.Horaires</div>
                        <div class="detail"><i class="fas fa-map-marker-alt"></i> @formation.Lieu</div>
                        <div class="detail"><i class="fas fa-users"></i> @formation.CapaciteMax places</div>
                    </div>
                    <button class="btn-formation btn-secondary" @onclick="() => OpenInscriptionModal(formation)">
                        <i class="fas fa-list"></i> Rejoindre la liste d'attente
                    </button>
                </div>
            }
        </div>
    </section>
}

<!-- ===== FORMATIONS TERMINÉES ===== -->
@if (formationsTerminees.Any())
{
    <section class="formations-section">
        <div class="section-header">
            <div class="header-glow"><i class="fas fa-history"></i> Historique</div>
            <h2>Formations <span class="gradient-text">terminées</span></h2>
            <div class="header-line"></div>
        </div>
        <div class="formations-grid">
            @foreach (var formation in formationsTerminees)
            {
                <div class="formation-card formation-terminee">
                    <div class="formation-header">
                        <span class="formation-status status-terminee">Terminée</span>
                    </div>
                    <h3>@formation.Titre</h3>
                    <p class="formation-desc">@formation.Description</p>
                    <div class="formation-details">
                        <div class="detail"><i class="fas fa-calendar"></i> @formation.DateDebut.ToString("dd/MM/yyyy") - @formation.DateFin.ToString("dd/MM/yyyy")</div>
                        <div class="detail"><i class="fas fa-map-marker-alt"></i> @formation.Lieu</div>
                    </div>
                    <button class="btn-formation btn-disabled" disabled>
                        <i class="fas fa-check"></i> Formation terminée
                    </button>
                </div>
            }
        </div>
    </section>
}
}

<!-- ===== MODAL INSCRIPTION ===== -->
@if (showInscriptionModal && selectedFormation != null)
{
    <div class="modal-overlay" @onclick="CloseInscriptionModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseInscriptionModal"><i class="fas fa-times"></i></button>
            <h2>Inscription - @selectedFormation.Titre</h2>
            <div class="formation-info">
                <div class="info-row"><i class="fas fa-calendar"></i> @selectedFormation.DateDebut.ToString("dd/MM/yyyy") - @selectedFormation.DateFin.ToString("dd/MM/yyyy")</div>
                <div class="info-row"><i class="fas fa-clock"></i> @selectedFormation.Horaires</div>
                <div class="info-row"><i class="fas fa-map-marker-alt"></i> @selectedFormation.Lieu</div>
                <div class="info-row"><i class="fas fa-money-bill-wave"></i> @selectedFormation.Prix.ToString("N0") FCFA</div>
            </div>
            <EditForm Model="@inscription" OnValidSubmit="HandleInscription">
                <div class="form-group">
                    <label>Nom complet *</label>
                    <InputText @bind-Value="inscription.Nom" class="form-input" />
                    <ValidationMessage For="@(() => inscription.Nom)" />
                </div>
                <div class="form-group">
                    <label>Email *</label>
                    <InputText @bind-Value="inscription.Email" type="email" class="form-input" />
                    <ValidationMessage For="@(() => inscription.Email)" />
                </div>
                <div class="form-group">
                    <label>Téléphone *</label>
                    <InputText @bind-Value="inscription.Telephone" class="form-input" />
                    <ValidationMessage For="@(() => inscription.Telephone)" />
                </div>
                <div class="form-group">
                    <label>Message (optionnel)</label>
                    <InputTextArea @bind-Value="inscription.Message" class="form-textarea" rows="3" />
                </div>
                @if (inscriptionSuccess)
                {
                    <div class="success-message">
                        <i class="fas fa-check-circle"></i> Inscription réussie ! Nous vous contacterons bientôt.
                    </div>
                }
                else
                {
                    @if (errorMessage != null)
                    {
                        <div class="error-message">
                            <i class="fas fa-exclamation-circle"></i> @errorMessage
                        </div>
                    }
                    <button type="submit" class="btn-submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <i class="fas fa-spinner fa-spin"></i> <text>Traitement en cours</text>
                        }
                        else
                        {
                            <i class="fas fa-paper-plane"></i> <text>Confirmer l'inscription</text>
                        }
                    </button>
                }
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Formation> allFormations = new();
    private List<Formation> formationsEnCours = new();
    private List<Formation> formationsAVenir = new();
    private List<Formation> formationsTerminees = new();
    private bool isLoading = true;
    
    private bool showInscriptionModal = false;
    private Formation? selectedFormation;
    private Inscription inscription = new();
    private bool isSubmitting = false;
    private bool inscriptionSuccess = false;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadFormations();
    }

    private async Task LoadFormations()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<Formation>>("api/formations");
            if (response != null)
            {
                allFormations = response;
                formationsEnCours = allFormations.Where(f => f.Statut == "En cours").ToList();
                formationsAVenir = allFormations.Where(f => f.Statut == "A venir").ToList();
                formationsTerminees = allFormations.Where(f => f.Statut == "Terminée").ToList();
            }
        }
        catch (Exception)
        {
            Console.WriteLine($"Erreur chargement formations");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenInscriptionModal(Formation formation)
    {
        selectedFormation = formation;
        inscription = new Inscription();
        inscriptionSuccess = false;
        errorMessage = null;
        showInscriptionModal = true;
    }

    private void CloseInscriptionModal()
    {
        showInscriptionModal = false;
        selectedFormation = null;
    }

    private async Task HandleInscription()
    {
        if (selectedFormation == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            inscription.FormationId = selectedFormation.Id;
            var response = await Http.PostAsJsonAsync($"api/formations/{selectedFormation.Id}/inscrire", inscription);

            if (response.IsSuccessStatusCode)
            {
                inscriptionSuccess = true;
                await LoadFormations(); // Recharger pour mettre à jour les places
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = errorContent ?? "Une erreur s'est produite lors de l'inscription.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Impossible de contacter le serveur. Veuillez réessayer.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<script>
    (function() {
        // ===== MORPHING CANVAS =====
        const canvas = document.getElementById('morphingCanvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width, height;
            let time = 0;
            
            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width;
                canvas.height = height;
            }
            
            function drawMorphing() {
                if (!ctx) return;
                ctx.clearRect(0, 0, width, height);
                
                const gradient = ctx.createLinearGradient(0, 0, width, height);
                gradient.addColorStop(0, '#1e3a8a');
                gradient.addColorStop(0.5, '#2563eb');
                gradient.addColorStop(1, '#3b82f6');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, width, height);
                
                const centerX = width / 2;
                const centerY = height / 2;
                
                for (let i = 0; i < 12; i++) {
                    ctx.beginPath();
                    const angle = (i / 12) * Math.PI * 2 + time * 0.3;
                    const radius = 150 + Math.sin(time * 0.5 + i) * 30;
                    const x = centerX + Math.cos(angle) * radius;
                    const y = centerY + Math.sin(angle) * radius;
                    
                    for (let j = 0; j < 30; j++) {
                        const subAngle = angle + (j / 30) * Math.PI * 2;
                        const subRadius = radius + Math.sin(time * 2 + subAngle * 3) * 40;
                        const px = centerX + Math.cos(subAngle) * subRadius;
                        const py = centerY + Math.sin(subAngle) * subRadius;
                        
                        ctx.fillStyle = `rgba(245, 166, 35, ${0.1 + Math.sin(time * 2 + i) * 0.05})`;
                        ctx.beginPath();
                        ctx.arc(px, py, 4 + Math.sin(time * 3 + i) * 2, 0, Math.PI * 2);
                        ctx.fill();
                    }
                }
                
                time += 0.02;
                requestAnimationFrame(drawMorphing);
            }
            
            window.addEventListener('resize', resize);
            resize();
            drawMorphing();
        }
        
        // ===== SCROLL REVEAL =====
        const revealElements = document.querySelectorAll('.formation-card');
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0) scale(1)';
                    revealObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        revealElements.forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(50px) scale(0.9)';
            el.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
            revealObserver.observe(el);
        });
    })();
</script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: #0a0f1c;
    overflow-x: hidden;
}

/* ===== HERO MORPHING ===== */
.hero-morphing {
    position: relative;
    height: 100vh;
    overflow: hidden;
}

#morphingCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, rgba(10,15,28,0.6) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 20px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    padding: 8px 24px;
    border-radius: 60px;
    color: #f5a623;
    font-weight: 600;
    margin-bottom: 30px;
    position: relative;
}

.badge-ring {
    position: absolute;
    inset: -2px;
    border-radius: 60px;
    border: 1px solid rgba(245,166,35,0.5);
    animation: ringPulse 2s infinite;
}

@@keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
}

.floating-badge {
    animation: floatBadge 3s infinite ease-in-out;
}

@@keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

.hero-title {
    font-size: clamp(2rem, 8vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 40px;
    line-height: 1.2;
}

.title-word {
    display: inline-block;
    color: white;
    margin: 0 10px;
    animation: titleGlow 2s ease-in-out infinite;
}

@@keyframes titleGlow {
    0%, 100% { text-shadow: 0 0 5px rgba(245,166,35,0.3); }
    50% { text-shadow: 0 0 20px rgba(245,166,35,0.8), 0 0 30px rgba(245,166,35,0.4); }
}

.title-word.accent {
    color: #f5a623;
}

.header-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
    margin-bottom: 60px;
}

.stat-item {
    text-align: center;
}

.stat-number {
    display: block;
    font-size: 2.5rem;
    color: #f5a623;
    font-weight: 800;
    margin-bottom: 0.5rem;
}

.stat-label {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.loading-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #f5a623;
    font-size: 1.2rem;
    margin-bottom: 40px;
}

.hero-scroll {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    animation: bounce 2s infinite;
}

@@keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
}

.scroll-mouse {
    width: 26px;
    height: 40px;
    border: 2px solid white;
    border-radius: 20px;
    display: flex;
    justify-content: center;
}

.scroll-wheel {
    width: 3px;
    height: 8px;
    background: white;
    border-radius: 2px;
    margin-top: 6px;
    animation: scrollWheel 1.5s infinite;
}

@@keyframes scrollWheel {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(15px); }
}

.hero-scroll span {
    color: rgba(255,255,255,0.6);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: rgba(255,255,255,0.6);
}

.loading-container .spinner {
    border: 3px solid rgba(255,255,255,0.1);
    border-top-color: #f5a623;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
}

@@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ===== FORMATIONS SECTION ===== */
.formations-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #0f1420, #0a0f1c);
}

.formations-section.alt-bg {
    background: linear-gradient(135deg, #0a0f1c, #0f1420);
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
}

.header-glow {
    display: inline-block;
    background: rgba(245,166,35,0.1);
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.8rem;
    color: #f5a623;
    margin-bottom: 20px;
    animation: headerGlow 3s infinite;
}

@@keyframes headerGlow {
    0%, 100% { box-shadow: 0 0 5px rgba(245,166,35,0.3); }
    50% { box-shadow: 0 0 20px rgba(245,166,35,0.5); }
}

.section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: white;
    margin-bottom: 15px;
}

.gradient-text {
    background: linear-gradient(135deg, #f5a623, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.header-line {
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, #f5a623, #3b82f6);
    margin: 0 auto;
    border-radius: 3px;
}

.formations-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
}

.formation-card {
    background: linear-gradient(135deg, #1a2332, #0f1420);
    border-radius: 24px;
    padding: 40px 30px;
    border: 1px solid rgba(59,130,246,0.2);
    transition: all 0.3s;
}

.formation-card:hover {
    transform: translateY(-5px);
    border-color: rgba(245,166,35,0.5);
    box-shadow: 0 10px 30px rgba(245,166,35,0.2);
}

.formation-card.formation-terminee {
    opacity: 0.6;
}

.formation-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.formation-status {
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.status-en-cours { background: rgba(59,130,246,0.2); color: #3b82f6; }
.status-avenir { background: rgba(245,166,35,0.2); color: #f5a623; }
.status-terminee { background: rgba(107,114,128,0.2); color: #6b7280; }

.formation-price {
    font-size: 1.3rem;
    font-weight: 800;
    color: #f5a623;
}

.formation-card h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 15px;
}

.formation-desc {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 20px;
}

.formation-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 25px;
}

.formation-details .detail {
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
}

.formation-details .detail i {
    color: #3b82f6;
    width: 18px;
}

.btn-formation {
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: none;
}

.btn-formation.btn-primary {
    background: #f5a623;
    color: #0a0f1c;
}

.btn-formation.btn-primary:hover {
    background: #e5941a;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(245,166,35,0.4);
}

.btn-formation.btn-secondary {
    background: rgba(59,130,246,0.2);
    color: #3b82f6;
    border: 1px solid rgba(59,130,246,0.3);
}

