@page "/produits"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CartService CartService
@inject NotificationService NotificationService
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Json

<PageTitle>Nos Produits | e-Tech Energie+</PageTitle>

<div class="products-page">
    <div class="page-header">
        <div class="container">
            <h1>Nos Produits</h1>
            <p>Découvrez notre gamme complète de produits pour l'énergie solaire et électrique</p>
        </div>
    </div>

    <div class="container">
        <div class="filters-section">
            <div class="search-box">
                <input type="text" 
                       @bind="searchQuery" 
                       @bind:event="oninput"
                       @onkeyup="HandleSearchKeyUp"
                       placeholder="Rechercher un produit..." 
                       class="search-input" />
                <button @onclick="SearchProducts" class="btn-search">
                    <i class="fas fa-search"></i>
                </button>
            </div>

            <div class="category-filter">
                <label>Catégorie :</label>
                <select @bind="selectedCategoryId" @bind:after="FilterByCategory" class="category-select">
                    <option value="">Toutes les catégories</option>
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="results-info">
                @if (pagedProducts != null)
                {
                    <span>
                        <strong>@pagedProducts.TotalItems</strong> produits trouvés
                        | Page <strong>@currentPage</strong> sur <strong>@pagedProducts.TotalPages</strong>
                    </span>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Chargement des produits...</p>
            </div>
        }
        else if (pagedProducts?.Items.Count > 0)
        {
            <div class="products-grid-compact">
                @foreach (var product in pagedProducts.Items)
                {
                    <div class="product-card-compact" @onclick="() => OpenProductModal(product)">
                        <div class="product-image-compact">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                            @if (product.Stock == 0)
                            {
                                <div class="stock-badge out-of-stock">Rupture</div>
                            }
                            else if (product.Stock < 5)
                            {
                                <div class="stock-badge low-stock">Stock limité</div>
                            }
                        </div>
                        <div class="product-info-compact">
                            <h3 class="product-name-compact">@product.Name</h3>
                            <p class="category-compact">@product.Category?.Name</p>
                            <div class="product-footer-compact">
                                <span class="price-compact">@product.Price.ToString("N0") FCFA</span>
                                <button class="btn-quick-view" @onclick:stopPropagation="true" @onclick="() => OpenProductModal(product)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="pagination-compact">
                <button class="btn-page-compact" 
                        @onclick="() => ChangePage(1)" 
                        disabled="@(!pagedProducts.HasPreviousPage)"
                        title="Première page">
                    <i class="fas fa-angle-double-left"></i>
                </button>
                
                <button class="btn-page-compact" 
                        @onclick="PreviousPage" 
                        disabled="@(!pagedProducts.HasPreviousPage)"
                        title="Page précédente">
                    <i class="fas fa-angle-left"></i>
                </button>

                <span class="page-info-compact">
                    Page <strong>@currentPage</strong> / <strong>@pagedProducts.TotalPages</strong>
                </span>

                <button class="btn-page-compact" 
                        @onclick="NextPage" 
                        disabled="@(!pagedProducts.HasNextPage)"
                        title="Page suivante">
                    <i class="fas fa-angle-right"></i>
                </button>

                <button class="btn-page-compact" 
                        @onclick="() => ChangePage(pagedProducts.TotalPages)" 
                        disabled="@(!pagedProducts.HasNextPage)"
                        title="Dernière page">
                    <i class="fas fa-angle-double-right"></i>
                </button>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-box-open fa-3x"></i>
                <h3>Aucun produit trouvé</h3>
                <p>Essayez de modifier vos critères de recherche</p>
                <button @onclick="ResetFilters" class="btn btn-primary">
                    Réinitialiser les filtres
                </button>
            </div>
        }
    </div>
</div>

@if (showModal && selectedProduct != null)
{
    <div class="modal-overlay" @onclick="CloseProductModal">
        <div class="modal-container" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseProductModal">
                <i class="fas fa-times"></i>
            </button>

            <div class="modal-content">
                <div class="modal-image-section">
                    <img src="@selectedProduct.ImageUrl" alt="@selectedProduct.Name" class="modal-image" />
                    @if (selectedProduct.Stock == 0)
                    {
                        <div class="stock-badge-modal out-of-stock">Rupture de stock</div>
                    }
                    else if (selectedProduct.Stock < 5)
                    {
                        <div class="stock-badge-modal low-stock">
                            <i class="fas fa-exclamation-triangle"></i> Stock limité (@selectedProduct.Stock restants)
                        </div>
                    }
                    else
                    {
                        <div class="stock-badge-modal in-stock">
                            <i class="fas fa-check-circle"></i> En stock (@selectedProduct.Stock disponibles)
                        </div>
                    }
                </div>

                <div class="modal-info-section">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title">@selectedProduct.Name</h2>
                            <p class="modal-category">
                                <i class="fas fa-tag"></i> @selectedProduct.Category?.Name
                            </p>
                        </div>
                        <div class="modal-price">
                            @selectedProduct.Price.ToString("N0") <span class="currency">FCFA</span>
                        </div>
                    </div>

                    <div class="modal-description">
                        <h3><i class="fas fa-info-circle"></i> Description</h3>
                        <p>@selectedProduct.Description</p>
                    </div>

                    <div class="modal-specs">
                        <h3><i class="fas fa-list"></i> Caractéristiques</h3>
                        <div class="specs-grid">
                            <div class="spec-item">
                                <span class="spec-label">Référence</span>
                                <span class="spec-value">#@selectedProduct.Id.ToString("D6")</span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">Catégorie</span>
                                <span class="spec-value">@selectedProduct.Category?.Name</span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">Stock</span>
                                <span class="spec-value">@selectedProduct.Stock unités</span>
                            </div>
                            <div class="spec-item">
                                <span class="spec-label">Prix unitaire</span>
                                <span class="spec-value">@selectedProduct.Price.ToString("N0") FCFA</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-actions">
                        <button class="btn-add-cart-modal" 
                                @onclick="() => AddToCartFromModal(selectedProduct)"
                                disabled="@(selectedProduct.Stock == 0)">
                            <i class="fas fa-shopping-cart"></i>
                            @(selectedProduct.Stock == 0 ? "Indisponible" : "Ajouter au panier")
                        </button>
                        <button class="btn-close-modal" @onclick="CloseProductModal">
                            Fermer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<Product>? pagedProducts;
    private Category[]? categories;
    private bool isLoading = true;
    
    private int currentPage = 1;
    private int pageSize = 20; 
    private string selectedCategoryId = "";
    private string searchQuery = "";
    
    private System.Threading.Timer? searchDebounceTimer;

    private bool showModal = false;
    private Product? selectedProduct = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<Category[]>("api/categories");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement catégories: {ex.Message}");
        }
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/products?page={currentPage}&pageSize={pageSize}";
            
            if (!string.IsNullOrWhiteSpace(selectedCategoryId))
            {
                url += $"&categoryId={selectedCategoryId}";
            }
            
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                url += $"&search={Uri.EscapeDataString(searchQuery)}";
            }

            Console.WriteLine($"📦 Chargement des produits: Page {currentPage}, PageSize {pageSize}");
            
            pagedProducts = await Http.GetFromJsonAsync<PagedResult<Product>>(url);
            
            Console.WriteLine($"✅ {pagedProducts?.Items.Count ?? 0} produits chargés");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erreur chargement produits: {ex.Message}");
            NotificationService.ShowError("Erreur lors du chargement des produits");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || pagedProducts == null || newPage > pagedProducts.TotalPages)
            return;

        currentPage = newPage;
        await LoadProducts();
        
        await Navigation.NavigateToAsync("#");
    }

    private async Task NextPage()
    {
        if (pagedProducts?.HasNextPage == true)
        {
            await ChangePage(currentPage + 1);
        }
    }

    private async Task PreviousPage()
    {
        if (pagedProducts?.HasPreviousPage == true)
        {
            await ChangePage(currentPage - 1);
        }
    }

    private async Task FilterByCategory()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task SearchProducts()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchProducts();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedCategoryId = "";
        currentPage = 1;
        await LoadProducts();
    }

    private void OpenProductModal(Product product)
    {
        selectedProduct = product;
        showModal = true;
        Console.WriteLine($"🔍 Modal ouverte pour: {product.Name}");
        StateHasChanged();
    }

    private void CloseProductModal()
    {
        showModal = false;
        selectedProduct = null;
        StateHasChanged();
    }

    private void AddToCartFromModal(Product product)
    {
        CartService.AddToCart(product);
        NotificationService.ShowSuccess($"{product.Name} ajouté au panier");
        CloseProductModal();
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}

<style>
