</section>

<!-- Ancre scroll -->
<div id="products-anchor"></div>

<!-- ===== SECTION PRODUITS ===== -->
<div class="products-page">
    <div class="container">

        <!-- Barre recherche + filtre -->
        <div class="filters-section">
            <div class="search-box">
                <input class="search-input"
                       placeholder="Rechercher un produit..."
                       value="@searchQuery"
                       @oninput="HandleSearch" />
                <button class="btn-search" @onclick="SearchProducts">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>
            <div class="category-filter">
                <label>Catégorie :</label>
                <select class="category-select" @bind="selectedCategoryId" @bind:after="FilterByCategory">
                    <option value="">Toutes les catégories</option>
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="results-info">
                @if (pagedProducts != null)
                {
                    <span>@pagedProducts.TotalItems produits trouvés</span>
                }
            </div>
        </div>

        <!-- Panier -->
        <div class="cart-bar">
            <a href="/cart" class="cart-link">
                <i class="fas fa-shopping-cart"></i>
                Panier (@CartService.ItemCount)
            </a>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Chargement des produits...</p>
            </div>
        }
        else if (pagedProducts?.Items?.Count > 0)
        {
            <div class="products-grid">
                @foreach (var product in pagedProducts.Items)
                {
                    <div class="product-card">
                        <div class="product-image" @onclick="() => ShowProduct(product)">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                            @if (product.Stock == 0)
                            {
                                <span class="stock-badge out-of-stock">Rupture</span>
                            }
                            else if (product.Stock < 5)
                            {
                                <span class="stock-badge low-stock">@product.Stock restants</span>
                            }
                        </div>
                        <div class="product-info">
                            <h3>@product.Name</h3>
                            <div class="category">@product.Category?.Name</div>
                            <div class="description-preview">@GetShortDescription(product.Description)</div>
                            <div class="product-footer">
                                <span class="price">@product.Price.ToString("N0") FCFA</span>
                                <button class="btn-add-cart"
                                        disabled="@(product.Stock == 0)"
                                        @onclick="() => AddToCart(product)"
                                        @onclick:stopPropagation="true">
                                    @if (product.Stock == 0)
                                    {
                                        <span>Indisponible</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-cart-plus"></i> Ajouter</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="pagination-container">
                    <span class="page-info">Page @currentPage sur @TotalPages (@pagedProducts.TotalItems produits)</span>
                    <div class="pagination">
                        <button class="btn-page" disabled="@(currentPage == 1)" @onclick="GoToFirstPage">«</button>
                        <button class="btn-page" disabled="@(currentPage == 1)" @onclick="PreviousPage">‹</button>
                        @foreach (var pageNum in GetPageNumbers())
                        {
                            <button class="btn-page @(pageNum == currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        <button class="btn-page" disabled="@(currentPage == TotalPages)" @onclick="NextPage">›</button>
                        <button class="btn-page" disabled="@(currentPage == TotalPages)" @onclick="GoToLastPage">»</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <h3>Aucun produit trouvé</h3>
            </div>
        }
    </div>
</div>

<!-- ===== MODAL DÉTAIL PRODUIT ===== -->
@if (showModal && selectedProduct != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseModal">✕</button>
            <div class="modal-body">
                <div class="modal-image-section">
                    <div class="modal-image-container">
                        <img src="@selectedProduct.ImageUrl" alt="@selectedProduct.Name" />
                    </div>
                </div>
                <div class="modal-details-section">
                    <div class="modal-category">@selectedProduct.Category?.Name</div>
                    <h2 class="modal-title">@selectedProduct.Name</h2>
                    <div class="modal-price">@selectedProduct.Price.ToString("N0") FCFA</div>
                    <div class="modal-description">
                        <h3>📋 Description</h3>
                        <p>@selectedProduct.Description</p>
                    </div>
                    <div class="modal-specs">
                        <div class="spec-item">
                            <div class="spec-icon">📦</div>
                            <div>
                                <strong>Stock disponible</strong>
                                <span>
                                    @if (selectedProduct.Stock == 0)
                                    {
                                        <span class="text-danger">Rupture de stock</span>
                                    }
                                    else if (selectedProduct.Stock < 5)
                                    {
                                        <span class="text-warning">Plus que @selectedProduct.Stock unités</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">@selectedProduct.Stock unités disponibles</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">🏷️</div>
                            <div>
                                <strong>Référence</strong>
                                <span>#PROD-@selectedProduct.Id.ToString("D4")</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-actions">
                        @if (selectedProduct.Stock > 0)
                        {
                            <div class="quantity-selector">
                                <button class="qty-btn" @onclick="DecreaseQuantity" disabled="@(modalQuantity <= 1)">−</button>
                                <input type="number" @bind="modalQuantity" min="1" max="@selectedProduct.Stock" class="qty-input" />
                                <button class="qty-btn" @onclick="IncreaseQuantity" disabled="@(modalQuantity >= selectedProduct.Stock)">+</button>
                            </div>
                            <button class="btn-add-to-cart-large" @onclick="AddToCartFromModal">
                                🛒 Ajouter au panier
                            </button>
                        }
                        else
                        {
                            <button class="btn-out-of-stock-large" disabled>✕ Produit indisponible</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<Product>? pagedProducts;
    private Category[]? categories;
    private bool isLoading = true;
    private string searchQuery = "";
    private string selectedCategoryId = "";
    private string? selectedCategoryName;
    private Product? selectedProduct;
    private bool showModal = false;
    private int modalQuantity = 1;
    private int currentPage = 1;
    private const int PageSize = 20;

    private int TotalPages =>
        pagedProducts == null || pagedProducts.TotalItems == 0
            ? 1
            : (int)Math.Ceiling(pagedProducts.TotalItems / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    async Task LoadCategories()
    {
        try { categories = await Http.GetFromJsonAsync<Category[]>("api/categories"); }
        catch (Exception ex) { Console.WriteLine($"Erreur catégories: {ex.Message}"); }
    }

    async Task LoadProducts()
    {
        isLoading = true;
        try
        {
            var url = $"api/products?page={currentPage}&pageSize={PageSize}";
            if (!string.IsNullOrWhiteSpace(searchQuery))
                url += $"&search={Uri.EscapeDataString(searchQuery)}";
            if (!string.IsNullOrWhiteSpace(selectedCategoryId))
                url += $"&categoryId={selectedCategoryId}";
            pagedProducts = await Http.GetFromJsonAsync<PagedResult<Product>>(url);
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        isLoading = false;
    }

    async Task SelectCategory(object? _)
    {
        selectedCategoryId = "";
        selectedCategoryName = null;
        currentPage = 1;
        await LoadProducts();
        await JS.InvokeVoidAsync("scrollToElement", "products-anchor");
    }

    async Task SelectCategoryByName(string name)
    {
        selectedCategoryName = name;
        var category = categories?.FirstOrDefault(c => c.Name == name);
        if (category != null)
        {
            selectedCategoryId = category.Id.ToString();
            currentPage = 1;
            await LoadProducts();
        }
        await JS.InvokeVoidAsync("scrollToElement", "products-anchor");
    }

    async Task FilterByCategory()
    {
        selectedCategoryName = null;
        currentPage = 1;
        await LoadProducts();
    }

    async Task SearchProducts()
    {
        currentPage = 1;
        await LoadProducts();
    }

    async Task HandleSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadProducts();
    }

    async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
        await LoadProducts();
    }

    async Task PreviousPage() => await GoToPage(currentPage - 1);
    async Task NextPage() => await GoToPage(currentPage + 1);
    async Task GoToFirstPage() => await GoToPage(1);
    async Task GoToLastPage() => await GoToPage(TotalPages);

    IEnumerable<int> GetPageNumbers()
    {
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(TotalPages, currentPage + 2);
        return Enumerable.Range(start, end - start + 1);
    }

    void AddToCart(Product product)
    {
        CartService.AddToCart(product);
        NotificationService.ShowSuccess($"{product.Name} ajouté au panier");
    }

    void ShowProduct(Product product)
    {
        selectedProduct = product;
        modalQuantity = 1;
        showModal = true;
    }

    void CloseModal()
    {
        showModal = false;
        selectedProduct = null;
        modalQuantity = 1;
    }

    void IncreaseQuantity()
    {
        if (selectedProduct != null && modalQuantity < selectedProduct.Stock) modalQuantity++;
    }

    void DecreaseQuantity()
    {
        if (modalQuantity > 1) modalQuantity--;
    }

    void AddToCartFromModal()
    {
        if (selectedProduct != null)
        {
            for (int i = 0; i < modalQuantity; i++)
                CartService.AddToCart(selectedProduct);
            NotificationService.ShowSuccess($"{modalQuantity} x {selectedProduct.Name} ajouté(s) au panier");
            CloseModal();
        }
    }

    string GetShortDescription(string? description)
    {
        if (string.IsNullOrEmpty(description)) return "";
        return description.Length > 60 ? description.Substring(0, 60) + "..." : description;
    }
}

