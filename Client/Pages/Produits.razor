@page "/products"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CartService CartService
@inject NotificationService NotificationService
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Json

<PageTitle>Nos Produits | e-Tech Energie+</PageTitle>

<div class="products-page">
    <div class="page-header">
        <div class="container">
            <h1>Nos Produits</h1>
            <p>Découvrez notre gamme complète de produits pour l'énergie solaire et électrique</p>
        </div>
    </div>

    <div class="container">
        <div class="filters-section">
            <div class="search-box">
                <input type="text" 
                       @bind="searchQuery" 
                       @bind:event="oninput"
                       @onkeyup="HandleSearchKeyUp"
                       placeholder="Rechercher un produit..." 
                       class="search-input" />
                <button @onclick="SearchProducts" class="btn-search">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>

            <div class="category-filter">
                <label>Catégorie :</label>
                <select @bind="selectedCategoryId" @bind:after="FilterByCategory" class="category-select">
                    <option value="">Toutes les catégories</option>
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="results-info">
                @if (pagedProducts != null)
                {
                    <span>
                        <i class="fas fa-box"></i>
                        Affichage de @pagedProducts.FirstItemIndex à @pagedProducts.LastItemIndex 
                        sur @pagedProducts.TotalItems produits
                    </span>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Chargement des produits...</p>
            </div>
        }
        else if (pagedProducts?.Items.Count > 0)
        {
            <div class="products-grid">
                @foreach (var product in pagedProducts.Items)
                {
                    <div class="product-card" @onclick="() => ShowProductDetails(product)">
                        <div class="product-image">
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                            @if (product.Stock == 0)
                            {
                                <div class="stock-badge out-of-stock">Rupture</div>
                            }
                            else if (product.Stock < 5)
                            {
                                <div class="stock-badge low-stock">@product.Stock restants</div>
                            }
                        </div>
                        <div class="product-info">
                            <h3>@product.Name</h3>
                            <p class="category">
                                <i class="fas fa-tag"></i> @product.Category?.Name
                            </p>
                            <p class="description-preview">@GetShortDescription(product.Description)</p>
                            <div class="product-footer">
                                <span class="price">@product.Price.ToString("N0") FCFA</span>
                                <button class="btn-view-details" @onclick:stopPropagation="true" @onclick="() => ShowProductDetails(product)">
                                    <i class="fas fa-eye"></i> Voir
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="pagination-container">
                <div class="pagination">
                    <button class="btn-page" 
                            @onclick="() => ChangePage(1)" 
                            disabled="@(!pagedProducts.HasPreviousPage)"
                            title="Première page">
                        <i class="fas fa-angle-double-left"></i>
                    </button>
                    
                    <button class="btn-page" 
                            @onclick="PreviousPage" 
                            disabled="@(!pagedProducts.HasPreviousPage)"
                            title="Page précédente">
                        <i class="fas fa-angle-left"></i>
                    </button>

                    <div class="page-info">
                        Page <strong>@currentPage</strong> sur <strong>@pagedProducts.TotalPages</strong>
                    </div>

                    <button class="btn-page" 
                            @onclick="NextPage" 
                            disabled="@(!pagedProducts.HasNextPage)"
                            title="Page suivante">
                        <i class="fas fa-angle-right"></i>
                    </button>

                    <button class="btn-page" 
                            @onclick="() => ChangePage(pagedProducts.TotalPages)" 
                            disabled="@(!pagedProducts.HasNextPage)"
                            title="Dernière page">
                        <i class="fas fa-angle-double-right"></i>
                    </button>
                </div>

                <div class="page-jump">
                    <label>Aller à la page :</label>
                    <input type="number" 
                           min="1" 
                           max="@pagedProducts.TotalPages" 
                           @bind="pageJump" 
                           @onkeyup="HandlePageJumpKeyUp"
                           class="page-jump-input" />
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-box-open fa-3x"></i>
                <h3>Aucun produit trouvé</h3>
                <p>Essayez de modifier vos critères de recherche</p>
                <button @onclick="ResetFilters" class="btn btn-primary">
                    <i class="fas fa-redo"></i> Réinitialiser les filtres
                </button>
            </div>
        }
    </div>
</div>

@if (showModal && selectedProduct != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseModal">
                <i class="fas fa-times"></i>
            </button>

            <div class="modal-body">
                <div class="modal-image-section">
                    <div class="modal-image-container">
                        <img src="@selectedProduct.ImageUrl" alt="@selectedProduct.Name" />
                        @if (selectedProduct.Stock == 0)
                        {
                            <div class="stock-badge-large out-of-stock">
                                <i class="fas fa-times-circle"></i> Rupture de stock
                            </div>
                        }
                        else if (selectedProduct.Stock < 5)
                        {
                            <div class="stock-badge-large low-stock">
                                <i class="fas fa-exclamation-circle"></i> Plus que @selectedProduct.Stock en stock
                            </div>
                        }
                        else
                        {
                            <div class="stock-badge-large in-stock">
                                <i class="fas fa-check-circle"></i> En stock (@selectedProduct.Stock disponibles)
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-details-section">
                    <div class="modal-category">
                        <i class="fas fa-tag"></i> @selectedProduct.Category?.Name
                    </div>
                    
                    <h2 class="modal-title">@selectedProduct.Name</h2>
                    
                    <div class="modal-price">
                        @selectedProduct.Price.ToString("N0") FCFA
                    </div>

                    <div class="modal-description">
                        <h3><i class="fas fa-info-circle"></i> Description</h3>
                        <p>@selectedProduct.Description</p>
                    </div>

                    <div class="modal-specs">
                        <div class="spec-item">
                            <i class="fas fa-box"></i>
                            <div>
                                <strong>Stock disponible</strong>
                                <span>@selectedProduct.Stock unités</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <i class="fas fa-barcode"></i>
                            <div>
                                <strong>Référence</strong>
                                <span>#PROD-@selectedProduct.Id.ToString("D4")</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <strong>Disponibilité</strong>
                                <span>@(selectedProduct.IsAvailable ? "Disponible" : "Indisponible")</span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-actions">
                        @if (selectedProduct.Stock > 0)
                        {
                            <div class="quantity-selector">
                                <button class="qty-btn" @onclick="DecreaseQuantity" disabled="@(modalQuantity <= 1)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" 
                                       @bind="modalQuantity" 
                                       min="1" 
                                       max="@selectedProduct.Stock" 
                                       class="qty-input" />
                                <button class="qty-btn" @onclick="IncreaseQuantity" disabled="@(modalQuantity >= selectedProduct.Stock)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>

                            <button class="btn-add-to-cart-large" @onclick="AddToCartFromModal">
                                <i class="fas fa-shopping-cart"></i>
                                Ajouter au panier
                            </button>
                        }
                        else
                        {
                            <button class="btn-out-of-stock-large" disabled>
                                <i class="fas fa-times-circle"></i>
                                Produit indisponible
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<Product>? pagedProducts;
    private Category[]? categories;
    private bool isLoading = true;
    
    private int currentPage = 1;
    private int pageSize = 20; 
    private string selectedCategoryId = "";
    private string searchQuery = "";
    private int pageJump = 1;
    
    private System.Threading.Timer? searchDebounceTimer;

    private bool showModal = false;
    private Product? selectedProduct;
    private int modalQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<Category[]>("api/categories");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement catégories: {ex.Message}");
        }
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/products?page={currentPage}&pageSize={pageSize}";
            
            if (!string.IsNullOrWhiteSpace(selectedCategoryId))
            {
                url += $"&categoryId={selectedCategoryId}";
            }
            
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                url += $"&search={Uri.EscapeDataString(searchQuery)}";
            }

            pagedProducts = await Http.GetFromJsonAsync<PagedResult<Product>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement produits: {ex.Message}");
            NotificationService.ShowError("Erreur lors du chargement des produits");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || pagedProducts == null || newPage > pagedProducts.TotalPages)
            return;

        currentPage = newPage;
        pageJump = newPage;
        await LoadProducts();
        
        Navigation.NavigateTo(Navigation.Uri, forceLoad: false); 
    }

    private async Task NextPage()
    {
        if (pagedProducts?.HasNextPage == true)
        {
            await ChangePage(currentPage + 1);
        }
    }

    private async Task PreviousPage()
    {
        if (pagedProducts?.HasPreviousPage == true)
        {
            await ChangePage(currentPage - 1);
        }
    }

    private async Task FilterByCategory()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task SearchProducts()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await SearchProducts();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task HandlePageJumpKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && pageJump >= 1 && pagedProducts != null && pageJump <= pagedProducts.TotalPages)
        {
            await ChangePage(pageJump);
        }
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedCategoryId = "";
        currentPage = 1;
        await LoadProducts();
    }

    private void ShowProductDetails(Product product)
    {
        selectedProduct = product;
        modalQuantity = 1;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedProduct = null;
        modalQuantity = 1;
    }

    private void IncreaseQuantity()
    {
        if (selectedProduct != null && modalQuantity < selectedProduct.Stock)
        {
            modalQuantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (modalQuantity > 1)
        {
            modalQuantity--;
        }
    }

    private void AddToCartFromModal()
    {
        if (selectedProduct != null)
        {
            for (int i = 0; i < modalQuantity; i++)
            {
                CartService.AddToCart(selectedProduct);
            }
            
            NotificationService.ShowSuccess($"{modalQuantity} x {selectedProduct.Name} ajouté(s) au panier");
            CloseModal();
        }
    }

    private string GetShortDescription(string description)
    {
        if (string.IsNullOrEmpty(description))
            return "";
        
        return description.Length > 60 ? description.Substring(0, 60) + "..." : description;
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}

<style>
