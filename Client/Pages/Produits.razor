@page "/products"
@inject HttpClient Http
@inject CartService CartService
@inject NotificationService NotificationService
@inject IJSRuntime JS
@using System.Net.Http.Json
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services

<PageTitle>Nos Produits - e-Tech Energie+</PageTitle>
<HeadContent>
    <meta name="description" content="Découvrez notre gamme complète de panneaux solaires, d'équipements électroniques telles que des capteurs et microcontrolleurs et des equipements electrique à Thiès. Prix compétitifs et garantie." />
    <meta name="keywords" content="panneaux solaires Thiès, Kits arduino Thies, Microcontrolleurs Thies, Capteurs electronique Thies" />
    <meta property="og:title" content="Produits - Panneaux Solaires, Microcontrolleurs & Capteurs | e-Tech Energie+" />
    <meta property="og:description" content="Notre gamme complète de solutions énergétiques à Thiès" />
    <meta property="og:url" content="https://etechenergie.onrender.com/products" />
</HeadContent>

<div class="page-header">
    <div class="container">
        <h1>Nos Produits</h1>
        <p>Équipements électroniques et informatiques de qualité professionnelle</p>
    </div>
</div>

<!-- ===== SECTION CATÉGORIES EN CERCLES ===== -->
<section class="categories-section">
    <div class="container">
        <div class="section-header">
            <div class="section-tag"><i class="fas fa-th-large"></i> Parcourir par catégorie</div>
            <h2>Nos Catégories</h2>
        </div>

        <div class="categories-grid">

            <div class="category-item @(selectedCategoryId == "" ? "active" : "")" @onclick="() => SelectCategory(null)">
                <div class="category-circle">
                    <i class="fas fa-border-all"></i>
                </div>
                <span>Tout voir</span>
            </div>

            <!-- Câbles et connectique -->
            <div class="category-item @(selectedCategoryName == "Câbles et connectique" ? "active" : "")" @onclick='() => SelectCategoryByName("Câbles et connectique")'>
                <div class="category-circle">
                    <img src="images/categories/electrical-cable-energy-technology-equipment-isolated-white.jpg" alt="Câbles et connectique" />
                </div>
                <span>Câbles et connectique</span>
            </div>

            <!-- Capteurs électroniques -->
            <div class="category-item @(selectedCategoryName == "Capteurs électroniques" ? "active" : "")" @onclick='() => SelectCategoryByName("Capteurs électroniques")'>
                <div class="category-circle">
                    <img src="images/categories/ky-015-dht-11-temperatursensor-modul-615783.jpg" alt="Capteurs électroniques" />
                </div>
                <span>Capteurs électroniques</span>
            </div>

            <!-- Cartes de développement -->
            <div class="category-item @(selectedCategoryName == "Cartes de développement" ? "active" : "")" @onclick='() => SelectCategoryByName("Cartes de développement")'>
                <div class="category-circle">
                    <img src="images/categories/platine_uno_arduino_275601_1_fb33.jpg" alt="Cartes de développement" />
                </div>
                <span>Cartes de développement</span>
            </div>

            <!-- Énergies renouvelables -->
            <div class="category-item @(selectedCategoryName == "Énergies renouvelables" ? "active" : "")" @onclick='() => SelectCategoryByName("Énergies renouvelables")'>
                <div class="category-circle">
                    <img src="images/categories/solar-panel.jpg" alt="Énergies renouvelables" />
                </div>
                <span>Énergies renouvelables</span>
            </div>

            <!-- Équipements réseau -->
            <div class="category-item @(selectedCategoryName == "Équipements réseau" ? "active" : "")" @onclick='() => SelectCategoryByName("Équipements réseau")'>
                <div class="category-circle">
                    <img src="images/categories/commutateur-reseau-cables_1137-6.avif" alt="Équipements réseau" />
                </div>
                <span>Équipements réseau</span>
            </div>

            <!-- Kits -->
            <div class="category-item @(selectedCategoryName == "Kits" ? "active" : "")" @onclick='() => SelectCategoryByName("Kits")'>
                <div class="category-circle">
                    <img src="images/categories/KitArduinoUno.jpg" alt="Kits" />
                </div>
                <span>Kits</span>
            </div>

            <!-- Module de Communication -->
            <div class="category-item @(selectedCategoryName == "Module de Communication" ? "active" : "")" @onclick='() => SelectCategoryByName("Module de Communication")'>
                <div class="category-circle">
                    <img src="images/categories/moduledecomunicationlora.jpg" alt="Module de Communication" />
                </div>
                <span>Module de Communication</span>
            </div>

            <!-- Outils de programmation -->
            <div class="category-item @(selectedCategoryName == "Outils de programmation" ? "active" : "")" @onclick='() => SelectCategoryByName("Outils de programmation")'>
                <div class="category-circle">
                    <img src="images/categories/outildeprogrammationpickit3.jpg" alt="Outils de programmation" />
