@page "/services"
@inject IJSRuntime JS
@inject HttpClient Http
@using ETechEnergie.Shared.Models
@implements IDisposable

<PageTitle>Services d'électricité et énergie solaire au Sénégal | e-Tech Energie+</PageTitle>

<HeadContent>
    <meta name="description" content="Découvrez nos services haut de gamme en installation électrique, énergie solaire, froid et automatique au Sénégal." />
    <meta name="keywords" content="Installation Électrique Domestique et Industrielle Thiès, Dimensionnement et Installation Solaire Thies, Climatisation Sénégal, BTP" />
    <meta property="og:title" content="Services | e-Tech Energie+" />
    <meta property="og:description" content="Nos services techniques réunissent rigueur industrielle et excellence énergétique." />
    <meta property="og:url" content="https://etechenergie.onrender.com/services" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
</HeadContent>

<!-- ===== HEADER  ===== -->
<div class="page-header">
    <div class="header-grid-bg"></div>
    <div class="container relative-z">
        <div class="header-badge">
            <i class="fas fa-award"></i> e-Tech Expertise &amp; Services
        </div>
        <h1>Nos Solutions <span class="accent">Énergétiques</span></h1>
        <p class="header-sub">
            Des solutions durables d'ingénierie, d'installation électrique et d'énergie 
            solaire de haute technologie adaptées aux réalités du Sénégal.
        </p>

        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-number">450 kWc+</span>
                <span class="stat-label">Solaire Installé</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">100% Sûr</span>
                <span class="stat-label">Norme NFC 15-100</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">50+</span>
                <span class="stat-label">Clients Satisfaits</span>
            </div>
        </div>
    </div>
</div>

<!-- ===== NAV PILLS  ===== -->
<div class="pill-nav-wrap">
    <nav class="pill-nav">
        <button class="pill @(activeCategory == "all" ? "active" : "")" @onclick='() => SetCategory("all")'>
            <i class="fas fa-bolt"></i> Tous
        </button>
        <button class="pill @(activeCategory == "solaire" ? "active" : "")" @onclick='() => SetCategory("solaire")'>
            <i class="fas fa-sun"></i> Solaire
        </button>
        <button class="pill @(activeCategory == "electricite" ? "active" : "")" @onclick='() => SetCategory("electricite")'>
            <i class="fas fa-plug"></i> Électricité
        </button>
        <button class="pill @(activeCategory == "froid" ? "active" : "")" @onclick='() => SetCategory("froid")'>
            <i class="fas fa-wind"></i> Froid &amp; Clim
        </button>
        <button class="pill @(activeCategory == "btp" ? "active" : "")" @onclick='() => SetCategory("btp")'>
            <i class="fas fa-HardHat"></i> Génie Civil
        </button>
        <button class="pill @(activeCategory == "it" ? "active" : "")" @onclick='() => SetCategory("it")'>
            <i class="fas fa-Network"></i> Télécoms &amp; IT
        </button>
    </nav>
</div>

<!-- ===== Body ===== -->
<section class="services-section" id="services-grid">
    <div class="container">
        @if (services == null)
        {
            <div class="loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p>Chargement de nos compétences clés...</p>
            </div>
        }
        else if (!GetFilteredServices().Any())
        {
            <p class="no-data">Aucun service disponible pour cette catégorie.</p>
        }
        else
        {
            <div class="services-list">
                @foreach (var s in GetFilteredServices())
                {
                    var isDarkTheme = s.Category == "electricite";
                    <div class="service-detail-card @(isDarkTheme ? "dark-theme" : "")">
                        
                        <!-- Header de section adaptative -->
                        <div class="service-header">
                            <div class="eyebrow-badge">
                                <span class="ey-line"></span>
                                <i class="fas @s.IconClass"></i>
                                <span>@s.CategoryDisplayName</span>
                            </div>
                            
                            <h2>
                                @s.NameTitlePart <br />
                                <em class="accent-title">&amp; @s.NameSubtitlePart</em>
                            </h2>
                        </div>

                        <!-- Body de la fiche -->
                        <div class="service-body">
                            <p class="service-description">@s.Description</p>
                            
                            <!-- Spécificités techniques -->
                            <div class="tech-specifications-grid">
                                @if (s.DetailsList != null)
                                {
                                    @foreach (var detail in s.DetailsList)
                                    {
                                        <div class="tech-spec-item">
                                            <h4><i class="fas fa-check-circle"></i> @detail.Title</h4>
                                            <p>@detail.Content</p>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Stat de performance embarquée -->
                            @if (!string.IsNullOrEmpty(s.StatValue))
                            {
                                <div class="perf-metric-badge">
                                    <div class="pm-text">
                                        <span class="pm-label">Performance Projet</span>
                                        <span class="pm-desc">@s.StatLabel</span>
                                    </div>
                                    <span class="pm-value">@s.StatValue</span>
                                </div>
                            }

                            <!-- CAROUSEL VISUEL  -->
                            @if (s.ImagesList != null && s.ImagesList.Any())
                            {
                                var currentImgIndex = GetCurrentIndex(s.Id, s.ImagesList.Count);
                                <div class="service-carousel-wrap">
                                    <div class="hero-image-side" @onclick='() => OpenModal(s, currentImgIndex)'>
                                        <img src="@s.ImagesList[currentImgIndex].Url" alt="@s.ImagesList[currentImgIndex].Caption" class="hero-img" />
                                        
                                        <div class="hero-img-overlay">
                                            <button type="button" class="zoom-btn"><i class="fas fa-expand-arrows-alt"></i> Agrandir</button>
                                        </div>

                                        <div class="img-counter-badge">
                                            <span class="img-cur">@(currentImgIndex + 1)</span>
                                            <span class="img-sep">/</span>
                                            <span class="img-tot">@s.ImagesList.Count</span>
                                        </div>

                                        <!-- Progress-bar barrettes -->
                                        @if (s.ImagesList.Count > 1)
                                        {
                                            <div class="progress-bar-wrap">
                                                @for (int idx = 0; idx < s.ImagesList.Count; idx++)
                                                {
                                                    var capturedIdx = idx;
                                                    <div class="pb-seg @(capturedIdx == currentImgIndex ? "active" : "")"
                                                         @onclick:stopPropagation="true"
                                                         @onclick='() => SetImageIndex(s.Id, capturedIdx)'></div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Navigation manuelle par flèches -->
                                    @if (s.ImagesList.Count > 1)
                                    {
                                        <div class="hero-arrows">
                                            <button type="button" class="arrow-btn" @onclick:stopPropagation="true" @onclick='() => StepImage(s.Id, s.ImagesList.Count, -1)'><i class="fas fa-arrow-left"></i></button>
                                            <button type="button" class="arrow-btn" @onclick:stopPropagation="true" @onclick='() => StepImage(s.Id, s.ImagesList.Count, 1)'><i class="fas fa-arrow-right"></i></button>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Bouton d'action Devis -->
                            <div class="service-actions">
                                <a href="/contact?service=@s.Id" class="btn btn-primary">
                                    <i class="fas fa-file-alt"></i> Demander un devis gratuit
                                </a>
                            </div>
                        </div>

                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ===== FAQ & PROMESSE ===== -->
<div class="container qa-layout">
    <div class="qa-col">
        <h3><i class="fas fa-question-circle"></i> Foire Aux <span class="accent">Questions</span></h3>
        <div class="accordion-group">
            @for (int i = 0; i < Faqs.Count; i++)
            {
                var idx = i;
                var isOpen = openFaqIndex == idx;
                <div class="accord-box">
                    <button class="accord-head" @onclick="() => ToggleFaq(idx)">
                        <span>@Faqs[idx].Question</span>
                        <i class="fas fa-chevron-down @(isOpen ? "rotate-icon" : "")"></i>
                    </button>
                    @if (isOpen)
                    {
                        <div class="accord-body">
                            @Faqs[idx].Answer
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="guarantee-card">
        <span class="badge-accent"><i class="fas fa-sparkles"></i> e-Tech Engagement</span>
        <h3>La Promesse <br />e-Tech Energie+</h3>
        <p>Basés à Thiès, nous unissons rigueur industrielle, éthique et conformité internationale pour tous nos clients du Sénégal.</p>
        <hr />
        <ul class="promesses-list">
            <li>
                <i class="fas fa-shield-alt"></i>
                <div>
                    <strong>Garantie de Qualité</strong>
                    <span>Respect strict de la norme NF C 15-100 pour l'électricité générale.</span>
                </div>
            </li>
            <li>
                <i class="fas fa-solar-panel"></i>
                <div>
                    <strong>Matériel Certifié</strong>
                    <span>Panneaux monocristallins robustes garantis 25 ans en rendement.</span>
                </div>
            </li>
            <li>
                <i class="fas fa-comments-dollar"></i>
                <div>
                    <strong>Suivi &amp; SAV localisé</strong>
                    <span>Assistance réactive basée à Thiès avec supervision IoT.</span>
                </div>
            </li>
        </ul>
    </div>
</div>

<!-- ===== CTA COMPLEMENTAIRE ===== -->
<section class="cta-services">
    <div class="cta-inner">
        <div class="cta-deco-text">PROJET</div>
        <div class="cta-content">
            <h2>Vous avez un projet ?</h2>
            <p>Notre équipe d'ingénieurs à Thiès est prête à étudier vos spécifications.</p>
            <a href="/contact" class="btn btn-light btn-lg">
                Demander une étude gratuite <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- ===== MODAL DE VISUALISATION ZOOME ===== -->
@if (showModal && selectedService != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-shell" @onclick:stopPropagation="true">
            <button class="modal-x" @onclick="CloseModal"><i class="fas fa-times"></i></button>

            <div class="modal-body">
                <div class="modal-visual">
                    <img src="@selectedService.ImagesList[modalImageIndex].Url" alt="@selectedService.ImagesList[modalImageIndex].Caption" />
                </div>
                <div class="modal-panel">
                    <div class="mp-tag">
                        <i class="fas @selectedService.IconClass"></i> @selectedService.CategoryDisplayName
                    </div>
                    <h2 class="mp-title">@selectedService.NameTitlePart @selectedService.NameSubtitlePart</h2>
                    <p class="mp-desc">@selectedService.ImagesList[modalImageIndex].Caption</p>
                    
                    <div class="mp-counter">@(modalImageIndex + 1) <em>/</em> @selectedService.ImagesList.Count</div>
                    <a href="/contact?service=@selectedService.Id" class="btn btn-primary" style="margin-top: auto; text-align: center;">Chiffrer ce type d'ouvrage</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ServiceViewModel>? services;
    private string activeCategory = "all";
    private int openFaqIndex = -1;

    private Dictionary<string, int> carouselIndices = new();

    private bool showModal = false;
    private ServiceViewModel? selectedService;
    private int modalImageIndex = 0;

    private System.Timers.Timer? autoTimer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiServices = await Http.GetFromJsonAsync<ServiceDto[]>("api/services");
            if (apiServices != null)
            {
                services = apiServices.Select(s => new ServiceViewModel(s)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur API: {ex.Message}. Utilisation de l'architecture locale e-Tech.");
            InitializeMockServices();
        }

        // Timer de rotation des carrousels
        autoTimer = new System.Timers.Timer(5000);
        autoTimer.Elapsed += (_, _) => InvokeAsync(() =>
        {
            if (services != null)
            {
                foreach (var s in services)
                {
                    if (s.ImagesList != null && s.ImagesList.Count > 1)
                    {
                        var cur = GetCurrentIndex(s.Id, s.ImagesList.Count);
                        carouselIndices[s.Id] = (cur + 1) % s.ImagesList.Count;
                    }
                }
                StateHasChanged();
            }
        });
        autoTimer.AutoReset = true;
        autoTimer.Enabled = true;
    }

