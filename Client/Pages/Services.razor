@page "/services"
@inject HttpClient Http
@using ETechEnergie.Shared.Models

<PageTitle>Nos Services - e-Tech Energie+</PageTitle>
<HeadContent>
    <meta name="description" content="Découvrez nos services variés incluant l'installation électrique domestique et industrielle, les solutions solaires, l'informatique et télécommunications, ainsi que le BTP." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<!-- ===== HERO MORPHING ===== -->
<div class="hero-morphing">
    <canvas id="morphingCanvas"></canvas>
    <div class="hero-overlay"></div>
    
    <div class="hero-content">
        <div class="hero-badge floating-badge">
            <i class="fas fa-cogs"></i> e-Tech Services
            <div class="badge-ring"></div>
        </div>
        
        <h1 class="hero-title">
            <span class="title-word" data-text="Nos">Nos</span>
            <span class="title-word accent" data-text="Services">Services</span>
            <span class="title-word" data-text="d'Excellence">d'Excellence</span>
        </h1>
        
        <div class="hero-cta">
            <a href="#services-list" class="cta-btn-primary">
                <span>Découvrir nos solutions</span>
                <i class="fas fa-arrow-down"></i>
                <div class="btn-glow"></div>
            </a>
            <a href="/contact" class="cta-btn-secondary">
                <i class="fas fa-calendar-check"></i>
                <span>Consultation gratuite</span>
            </a>
        </div>
        
        <div class="hero-scroll">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <span>Explorer</span>
        </div>
    </div>
</div>

<!-- ===== SERVICES LIST ===== -->
<section class="services-section" id="services-list">
    <div class="section-header">
        <div class="header-glow">✨ Solutions sur mesure ✨</div>
        <h2>Nos <span class="gradient-text">domaines d'expertise</span></h2>
        <div class="header-line"></div>
    </div>
    
    @if (services == null)
    {
        <div class="loading">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Chargement des services...</p>
        </div>
    }
    else if (!services.Any())
    {
        <p class="no-data">Aucun service disponible pour le moment.</p>
    }
    else
    {
        <div class="services-grid">
            @foreach (var service in services)
            {
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas @service.IconClass"></i>
                    </div>
                    <h3>@service.Name</h3>
                    <p>@service.Description</p>
                    <div class="service-details">
                        @service.DetailedDescription
                    </div>
                    <a href="/contact" class="service-btn">
                        <span>Demander un devis</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- ===== CTA FINAL ===== -->
<section class="cta-pulse">
    <div class="cta-pulse-container">
        <div class="cta-pulse-badge">🚀 Besoin d'un service personnalisé ?</div>
        <h2>Discutons de <span class="gradient-text">votre projet</span></h2>
        <p>Notre équipe d'experts est prête à vous accompagner</p>
        <a href="/contact" class="cta-pulse-btn">
            <span>Demander un devis gratuit</span>
            <i class="fas fa-arrow-right"></i>
            <div class="btn-pulse-ring"></div>
        </a>
    </div>
    <div class="cta-pulse-bg"></div>
</section>

@code {
    private Service[]? services;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            services = await Http.GetFromJsonAsync<Service[]>("api/services");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
        }
    }
}

<script>
    (function() {
        // ===== MORPHING CANVAS =====
        const canvas = document.getElementById('morphingCanvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width, height;
            let time = 0;
            
            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width;
                canvas.height = height;
            }
            
            function drawMorphing() {
                if (!ctx) return;
                ctx.clearRect(0, 0, width, height);
                
                const gradient = ctx.createLinearGradient(0, 0, width, height);
                gradient.addColorStop(0, '#1e3a8a');
                gradient.addColorStop(0.5, '#2563eb');
                gradient.addColorStop(1, '#3b82f6');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, width, height);
                
                const centerX = width / 2;
                const centerY = height / 2;
                
                for (let i = 0; i < 12; i++) {
                    ctx.beginPath();
                    const angle = (i / 12) * Math.PI * 2 + time * 0.3;
                    const radius = 150 + Math.sin(time * 0.5 + i) * 30;
                    const x = centerX + Math.cos(angle) * radius;
                    const y = centerY + Math.sin(angle) * radius;
                    
                    for (let j = 0; j < 30; j++) {
                        const subAngle = angle + (j / 30) * Math.PI * 2;
                        const subRadius = radius + Math.sin(time * 2 + subAngle * 3) * 40;
                        const px = centerX + Math.cos(subAngle) * subRadius;
                        const py = centerY + Math.sin(subAngle) * subRadius;
                        
                        ctx.fillStyle = `rgba(245, 166, 35, ${0.1 + Math.sin(time * 2 + i) * 0.05})`;
                        ctx.beginPath();
                        ctx.arc(px, py, 4 + Math.sin(time * 3 + i) * 2, 0, Math.PI * 2);
                        ctx.fill();
                    }
                }
                
                time += 0.02;
                requestAnimationFrame(drawMorphing);
            }
            
            window.addEventListener('resize', resize);
            resize();
            drawMorphing();
        }
        
        // ===== SCROLL REVEAL =====
        const revealElements = document.querySelectorAll('.service-card');
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0) scale(1)';
                    revealObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        revealElements.forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(50px) scale(0.9)';
            el.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
            revealObserver.observe(el);
        });
    })();
</script>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: #0a0f1c;
    overflow-x: hidden;
}

/* ===== HERO MORPHING ===== */
.hero-morphing {
    position: relative;
    height: 100vh;
    overflow: hidden;
}

#morphingCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, rgba(10,15,28,0.6) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 20px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    padding: 8px 24px;
    border-radius: 60px;
    color: #f5a623;
    font-weight: 600;
    margin-bottom: 30px;
    position: relative;
}

.badge-ring {
    position: absolute;
    inset: -2px;
    border-radius: 60px;
    border: 1px solid rgba(245,166,35,0.5);
    animation: ringPulse 2s infinite;
}

@@keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
}

.floating-badge {
    animation: floatBadge 3s infinite ease-in-out;
}

@@keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

.hero-title {
    font-size: clamp(2rem, 8vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 40px;
    line-height: 1.2;
}

.title-word {
    display: inline-block;
    color: white;
    margin: 0 10px;
    animation: titleGlow 2s ease-in-out infinite;
}

@@keyframes titleGlow {
    0%, 100% { text-shadow: 0 0 5px rgba(245,166,35,0.3); }
    50% { text-shadow: 0 0 20px rgba(245,166,35,0.8), 0 0 30px rgba(245,166,35,0.4); }
}

.title-word.accent {
    color: #f5a623;
}

.hero-cta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 60px;
}

.cta-btn-primary, .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 32px;
    border-radius: 60px;
    text-decoration: none;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
}

.cta-btn-primary {
    background: #f5a623;
    color: #0a0f1c;
}

.cta-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(245,166,35,0.4);
}

.btn-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.5s;
}

.cta-btn-primary:hover .btn-glow {
    left: 100%;
}

.cta-btn-secondary {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
}

.cta-btn-secondary:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-2px);
}

.hero-scroll {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    animation: bounce 2s infinite;
}

@@keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
}

.scroll-mouse {
    width: 26px;
    height: 40px;
    border: 2px solid white;
    border-radius: 20px;
    display: flex;
    justify-content: center;
}

.scroll-wheel {
    width: 3px;
    height: 8px;
    background: white;
    border-radius: 2px;
    margin-top: 6px;
    animation: scrollWheel 1.5s infinite;
}

@@keyframes scrollWheel {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(15px); }
}

.hero-scroll span {
    color: rgba(255,255,255,0.6);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

/* ===== SERVICES SECTION ===== */
.services-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #0f1420, #0a0f1c);
}

.section-header {
    text-align: center;
    margin-bottom: 60px;
}

.header-glow {
    display: inline-block;
    background: rgba(245,166,35,0.1);
    padding: 6px 20px;
    border-radius: 50px;
    font-size: 0.8rem;
    color: #f5a623;
    margin-bottom: 20px;
    animation: headerGlow 3s infinite;
}

@@keyframes headerGlow {
    0%, 100% { box-shadow: 0 0 5px rgba(245,166,35,0.3); }
    50% { box-shadow: 0 0 20px rgba(245,166,35,0.5); }
}

.section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: white;
    margin-bottom: 15px;
}

.gradient-text {
    background: linear-gradient(135deg, #f5a623, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.header-line {
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, #f5a623, #3b82f6);
    margin: 0 auto;
    border-radius: 3px;
}

.services-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
}

.service-card {
    background: linear-gradient(135deg, #1a2332, #0f1420);
    border-radius: 24px;
    padding: 40px 30px;
    text-align: center;
    border: 1px solid rgba(59,130,246,0.2);
    transition: all 0.3s;
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(245,166,35,0.5);
    box-shadow: 0 10px 30px rgba(245,166,35,0.2);
}

.service-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #f5a623, #e5941a);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 25px;
    font-size: 2rem;
    color: #0a0f1c;
}

.service-card h3 {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 15px;
}

.service-card p {
    color: rgba(255,255,255,0.8);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 20px;
}

.service-details {
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 25px;
}

.service-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(59,130,246,0.2);
    color: #3b82f6;
    padding: 12px 24px;
    border-radius: 60px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s;
}

.service-btn:hover {
    background: #f5a623;
    color: #0a0f1c;
    transform: translateY(-2px);
}

.loading {
    text-align: center;
    padding: 4rem;
    font-size: 1.5rem;
    color: #6b7280;
}

.loading i {
    font-size: 3rem;
    color: #3b82f6;
    margin-bottom: 1rem;
}

.no-data {
    text-align: center;
    padding: 3rem;
    font-size: 1.2rem;
    color: #6b7280;
}

/* ===== CTA PALPITANT ===== */
.cta-pulse {
    padding: 80px 20px;
    background: linear-gradient(135deg, #1e3a8a, #2563eb);
}

.cta-pulse-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    position: relative;
}

.cta-pulse-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.8rem;
    margin-bottom: 20px;
    animation: pulseBadge 2s infinite;
}

@@keyframes pulseBadge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.cta-pulse-container h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: white;
    margin-bottom: 15px;
}

.cta-pulse-container p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 30px;
}

.cta-pulse-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #f5a623;
    color: #0a0f1c;
    padding: 16px 40px;
    border-radius: 60px;
    text-decoration: none;
    font-weight: 700;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
}

.cta-pulse-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(245,166,35,0.4);
}

.btn-pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
    transition: width 0.4s, height 0.4s;
}

.cta-pulse-btn:active .btn-pulse-ring {
    width: 200px;
    height: 200px;
}

.cta-pulse-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(245,166,35,0.1), transparent);
    animation: pulseBg 3s infinite;
    pointer-events: none;
}

@@keyframes pulseBg {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.2); opacity: 1; }
}

/* ===== RESPONSIVE ===== */
@@media (max-width: 768px) {
    .services-grid {
        grid-template-columns: 1fr;
    }
    
    .hero-title {
        font-size: 2rem;
    }
    
    .hero-cta {
        flex-direction: column;
        align-items: center;
    }
}
</style>
