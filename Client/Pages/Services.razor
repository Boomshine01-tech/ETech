    private List<ServiceViewModel> GetFilteredServices()
    {
        if (services == null) return new();
        if (activeCategory == "all") return services;
        return services.Where(s => s.Category == activeCategory).ToList();
    }

    private void SetCategory(string cat)
    {
        activeCategory = cat;
        StateHasChanged();
    }

    private int GetCurrentIndex(string serviceId, int totalCount)
    {
        if (!carouselIndices.ContainsKey(serviceId))
        {
            carouselIndices[serviceId] = 0;
        }
        return carouselIndices[serviceId];
    }

    private void SetImageIndex(string serviceId, int index)
    {
        carouselIndices[serviceId] = index;
        StateHasChanged();
    }

    private void StepImage(string serviceId, int total, int step)
    {
        var cur = GetCurrentIndex(serviceId, total);
        var next = (cur + step + total) % total;
        carouselIndices[serviceId] = next;
        StateHasChanged();
    }

    private void ToggleFaq(int idx)
    {
        openFaqIndex = openFaqIndex == idx ? -1 : idx;
    }

    private void OpenModal(ServiceViewModel svc, int imgIdx)
    {
        selectedService = svc;
        modalImageIndex = imgIdx;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        selectedService = null;
    }

    public void Dispose()
    {
        autoTimer?.Stop();
        autoTimer?.Dispose();
    }

    public List<FAQItemVM> Faqs { get; } = new()
    {
        new("Comment se déroule le dimensionnement d'un projet solaire ?", "Notre équipe réalise d'abord un audit complet de vos appareils ou pose un enregistreur de charge sur votre compteur Senelec pour concevoir la capacité photovoltaïque nécessaire."),
        new("Intervenez-vous partout au Sénégal ?", "Bien que nos bureaux soient situés à Thiès, nos équipes se déplacent partout au Sénégal (Dakar, Saint-Louis, Casamance, Touba, etc.)."),
        new("Vos installations électriques sont-elles garanties ?", "Oui, absolument. Toutes nos installations sont assorties d'une garantie avec un SAV réactif.")
    };

    public class ServiceViewModel
    {
        public string Id { get; set; } = "";
        public string Category { get; set; } = "";
        public string CategoryDisplayName { get; set; } = "";
        public string NameTitlePart { get; set; } = "";
        public string NameSubtitlePart { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconClass { get; set; } = "";
        public string StatValue { get; set; } = "";
        public string StatLabel { get; set; } = "";
        public List<ServiceDetailVM>? DetailsList { get; set; }
        public List<ServiceImageVM>? ImagesList { get; set; }

        public ServiceViewModel() { }
        public ServiceViewModel(ServiceDto dto)
        {
            Id = dto.Id;
            Category = dto.Category;
            CategoryDisplayName = dto.CategoryDisplayName;
            NameTitlePart = dto.NameTitlePart;
            NameSubtitlePart = dto.NameSubtitlePart;
            Description = dto.Description;
            IconClass = dto.IconClass;
            StatValue = dto.StatValue;
            StatLabel = dto.StatLabel;
            DetailsList = dto.DetailsList?.Select(d => new ServiceDetailVM(d.Title, d.Content)).ToList();
            ImagesList = dto.ImagesList?.Select(i => new ServiceImageVM(i.Url, i.Caption)).ToList();
        }
    }

    public record ServiceDetailVM(string Title, string Content);
    public record ServiceImageVM(string Url, string Caption);
    public record FAQItemVM(string Question, string Answer);

    public class ServiceDto
    {
        public string Id { get; set; } = "";
        public string Category { get; set; } = "";
        public string CategoryDisplayName { get; set; } = "";
        public string NameTitlePart { get; set; } = "";
        public string NameSubtitlePart { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconClass { get; set; } = "";
        public string StatValue { get; set; } = "";
        public string StatLabel { get; set; } = "";
        public List<ServiceDetailDto>? DetailsList { get; set; }
        public List<ServiceImageDto>? ImagesList { get; set; }
    }
    public class ServiceDetailDto { public string Title { get; set; } = ""; public string Content { get; set; } = ""; }
    public class ServiceImageDto { public string Url { get; set; } = ""; public string Caption { get; set; } = ""; }
}

