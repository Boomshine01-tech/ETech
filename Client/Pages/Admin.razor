@page "/admin/products"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject AuthenticationService AuthService
@inject IJSRuntime JS
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Json
@using System.Net.Http.Headers

<PageTitle>Administration - Produits</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="admin-header">
        <div class="container">
            <div class="header-content">
                <div class="header-left">
                    <i class="fas fa-boxes"></i>
                    <div>
                        <h1>Gestion des Produits</h1>
                        <p class="subtitle">Gérez votre catalogue de produits</p>
                    </div>
                </div>
                <div class="user-info">
                    <div class="user-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="user-details">
                        <span class="username">@currentUsername</span>
                        <span class="role">Administrateur</span>
                    </div>
                    <button class="btn-logout" @onclick="Logout" title="Déconnexion">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
            <div class="admin-subnav">
                <a href="/admin/products" class="subnav-link active"><i class="fas fa-boxes"></i> Produits</a>
                <a href="/admin/formations" class="subnav-link"><i class="fas fa-graduation-cap"></i> Formations</a>
                <a href="/admin/announcement" class="subnav-link"><i class="fas fa-bullhorn"></i> Bande d'annonce</a>
                <a href="/admin/realisations" class="subnav-link"><i class="fas fa-images"></i> Réalisations</a>
            </div>
        </div>
    </div>

    <div class="admin-container">
        <div class="toolbar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Rechercher un produit..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <select @bind="categoryFilter" class="filter-select">
                    <option value="0">Toutes les catégories</option>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <button class="btn-secondary" @onclick="OpenCategoryManager">
                <i class="fas fa-tags"></i>
                <span>Catégories</span>
            </button>
            <button class="btn-primary" @onclick="ShowAddForm">
                <i class="fas fa-plus"></i>
                <span>Nouveau Produit</span>
            </button>
        </div>

        @if (products == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Chargement des produits...</p>
            </div>
        }
        else if (FilteredProducts.Length == 0)
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <h3>Aucun produit trouvé</h3>
                <p>@(string.IsNullOrEmpty(searchQuery) && categoryFilter == 0 ? "Commencez par ajouter votre premier produit" : "Aucun produit ne correspond à votre recherche")</p>
                @if (string.IsNullOrEmpty(searchQuery) && categoryFilter == 0)
                {
                    <button class="btn-primary" @onclick="ShowAddForm">
                        <i class="fas fa-plus"></i> Ajouter un Produit
                    </button>
                }
            </div>
        }
        else
        {
            <div class="products-grid">
                @foreach (var product in FilteredProducts)
                {
                    <div class="product-card">
                        <div class="product-image">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                            <div class="product-badges">
                                @if (product.Stock == 0)
                                {
                                    <span class="badge badge-danger">Rupture</span>
                                }
                                else if (product.Stock < 10)
                                {
                                    <span class="badge badge-warning">Stock faible</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">En stock</span>
                                }
                                @if (product.HasActiveDiscount)
                                {
                                    <span class="badge badge-discount"><i class="fas fa-tag"></i> -@product.DiscountPercentage%</span>
                                }
                            </div>
                        </div>
                        <div class="product-content">
                            <div class="product-category">@product.Category?.Name</div>
                            <h3 class="product-name">@product.Name</h3>
                            <p class="product-description">@product.Description</p>
                            <div class="product-footer">
                                <div class="product-info">
                                    <div class="price">
                                        <span class="price-label">Prix</span>
                                        @if (product.HasActiveDiscount)
                                        {
                                            <span class="price-value price-barred">@product.Price.ToString("N0") FCFA</span>
                                            <span class="price-value price-discounted">@product.EffectivePrice.ToString("N0") FCFA</span>
                                            @if (product.DiscountEndDate.HasValue)
                                            {
                                                <span class="discount-end">jusqu'au @product.DiscountEndDate.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="price-value">@product.Price.ToString("N0") FCFA</span>
                                        }
                                    </div>
                                    <div class="stock">
                                        <span class="stock-label">Stock</span>
                                        <span class="stock-value">@product.Stock unités</span>
                                    </div>
                                </div>
                                <div class="product-actions">
                                    <button class="btn-action btn-edit" @onclick="() => EditProduct(product)" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-action btn-delete" @onclick="() => DeleteProduct(product)" title="Supprimer">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (showForm)
    {
        <div class="modal-overlay" @onclick="CloseForm">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>@(editingProduct?.Id > 0 ? "Modifier le produit" : "Nouveau produit")</h2>
                    <button class="modal-close" @onclick="CloseForm">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <EditForm Model="@editingProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />

                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Nom du produit <span class="required">*</span></label>
                            <InputText class="form-input" @bind-Value="editingProduct!.Name" placeholder="Ex: Panneau solaire 300W" />
                            <ValidationMessage For="@(() => editingProduct.Name)" />
                        </div>

                        <div class="form-group">
                            <label>Catégorie <span class="required">*</span></label>
                            <InputSelect class="form-input" @bind-Value="editingProduct.CategoryId">
                                <option value="0">-- Sélectionner --</option>
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => editingProduct.CategoryId)" />
                        </div>

                        <div class="form-group">
                            <label>Prix (FCFA) <span class="required">*</span></label>
                            <div class="input-group">
                                <InputNumber class="form-input" @bind-Value="editingProduct.Price" placeholder="0" />
                                <span class="input-suffix">FCFA</span>
                            </div>
                            <ValidationMessage For="@(() => editingProduct.Price)" />
                        </div>

                        <div class="form-group">
                            <label>Stock <span class="required">*</span></label>
                            <InputNumber class="form-input" @bind-Value="editingProduct.Stock" placeholder="0" />
                            <ValidationMessage For="@(() => editingProduct.Stock)" />
                        </div>

                        <div class="form-group full-width">
                            <label>Description <span class="required">*</span></label>
                            <InputTextArea class="form-textarea" @bind-Value="editingProduct.Description"
                                          rows="4" placeholder="Décrivez les caractéristiques du produit..." />
                            <ValidationMessage For="@(() => editingProduct.Description)" />
                        </div>

                        <div class="form-group full-width">
                            <label>Image du produit</label>
                            <div class="image-upload-zone">
                                @if (string.IsNullOrEmpty(editingProduct.ImageUrl))
                                {
                                    <label for="imageUpload" class="upload-label">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <p>Cliquez pour choisir une image</p>
                                        <span class="upload-hint">PNG, JPG ou WEBP (max. 5MB)</span>
                                    </label>
                                }
                                else
                                {
                                    <div class="image-preview-container">
                                        <img src="@editingProduct.ImageUrl" alt="Aperçu" class="image-preview" />
                                        <button type="button" class="btn-remove-image" @onclick="RemoveImage">
                                            <i class="fas fa-times"></i>
                                        </button>
                                        <label for="imageUpload" class="btn-change-image">
                                            <i class="fas fa-sync-alt"></i> Changer l'image
                                        </label>
                                    </div>
                                }
                                <InputFile OnChange="HandleImageSelected" class="file-input" id="imageUpload" accept="image/*" />
                                @if (isUploadingImage)
                                {
                                    <div class="upload-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill"></div>
                                        </div>
                                        <p>Upload en cours...</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group full-width discount-section">
                            <label class="checkbox-label">
                                <input type="checkbox" checked="@hasDiscount" @onchange="ToggleDiscount" />
                                Activer une remise sur ce produit
                            </label>
                            <p class="hint">Le prix barré et le nouveau prix seront affichés automatiquement sur la fiche produit tant que la remise est active.</p>
                        </div>

                        @if (hasDiscount)
                        {
                            <div class="form-group">
                                <label>Prix promotionnel (FCFA) <span class="required">*</span></label>
                                <div class="input-group">
                                    <InputNumber class="form-input" @bind-Value="editingProduct.DiscountPrice" placeholder="0" />
                                    <span class="input-suffix">FCFA</span>
                                </div>
                                <p class="hint">Doit être inférieur au prix normal (@editingProduct.Price.ToString("N0") FCFA).</p>
                            </div>

                            <div class="form-group">
                                <label>Fin de la remise (optionnel)</label>
                                <InputDate class="form-input" @bind-Value="editingProduct.DiscountEndDate" />
                                <p class="hint">Laissez vide pour une remise sans date de fin. La remise s'applique jusqu'à 23h59 le jour choisi.</p>
                            </div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseForm" disabled="@isSaving">Annuler</button>
                        <button type="submit" class="btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin"></i> <text>Enregistrement...</text>
                            }
                            else
                            {
                                <i class="fas fa-save"></i> @(editingProduct?.Id > 0 ? "Modifier" : "Créer")
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (showCategoryModal)
    {
        <div class="modal-overlay" @onclick="CloseCategoryManager">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2><i class="fas fa-tags"></i> Catégories</h2>
                    <button class="modal-close" @onclick="CloseCategoryManager">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                @if (!showCategoryForm)
                {
                    <!-- ═══════ LISTE DES CATÉGORIES ═══════ -->
                    <div class="category-list-body">
                        <button class="btn-primary category-add-btn" @onclick="NewCategoryForm">
                            <i class="fas fa-plus"></i> Ajouter une catégorie
                        </button>

                        @if (categories == null || categories.Length == 0)
                        {
                            <p class="hint" style="text-align:center; padding: 1rem;">Aucune catégorie pour le moment.</p>
                        }
                        else
                        {
                            <div class="category-list">
                                @foreach (var cat in categories)
                                {
                                    <div class="category-row">
                                        <div class="category-row-thumb">
                                            @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                            {
                                                <img src="@cat.ImageUrl" alt="@cat.Name" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-tag"></i>
                                            }
                                        </div>
                                        <div class="category-row-info">
                                            <strong>@cat.Name</strong>
                                            @if (!string.IsNullOrEmpty(cat.Description))
                                            {
                                                <span>@cat.Description</span>
                                            }
                                        </div>
                                        <button class="btn-icon" title="Modifier" @onclick="() => EditCategoryForm(cat)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- ═══════ FORMULAIRE AJOUT / MODIFICATION ═══════ -->
                    <button class="category-back-btn" @onclick="() => showCategoryForm = false">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </button>

                    <EditForm Model="@editingCategory" OnValidSubmit="SaveCategory">
                        <DataAnnotationsValidator />

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label>Nom de la catégorie <span class="required">*</span></label>
                                <InputText class="form-input" @bind-Value="editingCategory!.Name" placeholder="Ex: Panneaux solaires" />
                                <ValidationMessage For="@(() => editingCategory.Name)" />
                            </div>

                            <div class="form-group full-width">
                                <label>Description</label>
                                <InputTextArea class="form-textarea" @bind-Value="editingCategory.Description"
                                              rows="2" placeholder="Description courte (optionnel)..." />
                                <ValidationMessage For="@(() => editingCategory.Description)" />
                            </div>

                            <div class="form-group full-width">
                                <label>Image (optionnel)</label>
                                <div class="image-upload-zone">
                                    @if (string.IsNullOrEmpty(editingCategory.ImageUrl))
                                    {
                                        <label for="categoryImageUpload" class="upload-label">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <p>Cliquez pour choisir une image</p>
                                            <span class="upload-hint">PNG, JPG ou WEBP (max. 5MB)</span>
                                        </label>
                                    }
                                    else
                                    {
                                        <div class="image-preview-container">
                                            <img src="@editingCategory.ImageUrl" alt="Aperçu" class="image-preview" />
                                            <button type="button" class="btn-remove-image" @onclick="RemoveCategoryImage">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <label for="categoryImageUpload" class="btn-change-image">
                                                <i class="fas fa-sync-alt"></i> Changer l'image
                                            </label>
                                        </div>
                                    }
                                    <InputFile OnChange="HandleCategoryImageSelected" class="file-input" id="categoryImageUpload" accept="image/*" />
                                    @if (isUploadingCategoryImage)
                                    {
                                        <div class="upload-progress">
                                            <div class="progress-bar">
                                                <div class="progress-fill"></div>
                                            </div>
                                            <p>Upload en cours...</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn-secondary" @onclick="() => showCategoryForm = false">Annuler</button>
                            <button type="submit" class="btn-primary" disabled="@isSavingCategory">
                                @if (isSavingCategory)
                                {
                                    <i class="fas fa-spinner fa-spin"></i> <text>Enregistrement...</text>
                                }
                                else
                                {
                                    <i class="fas fa-save"></i> @(editingCategory?.Id > 0 ? "Modifier" : "Créer")
                                }
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    }
</AuthGuard>

@code {
    private Product[]? products;
    private Category[]? categories;
    private Product? editingProduct;
    private bool showForm = false;
    private bool isSaving = false;
    private bool isUploadingImage = false;
    private bool hasDiscount = false;
    private string? currentUsername;
    private string searchQuery = "";
    private int categoryFilter = 0;

    private bool showCategoryModal = false;
    private bool showCategoryForm = false;
    private bool isSavingCategory = false;
    private bool isUploadingCategoryImage = false;
    private Category? editingCategory;

    private Product[] FilteredProducts
    {
        get
        {
            if (products == null) return Array.Empty<Product>();

            var query = products.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(p =>
                    p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Category?.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (categoryFilter != 0)
            {
                query = query.Where(p => p.CategoryId == categoryFilter);
            }

            return query.ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadData();
    }

    private async Task LoadCurrentUser()
    {
        var (username, _, _) = await AuthService.GetCurrentUserAsync();
        currentUsername = username ?? "Admin";
    }

    private async Task LoadData()
    {
        try
        {
            var allProducts = new List<Product>();
            int page = 1;
            PagedResult<Product>? result;

            do
            {
                result = await Http.GetFromJsonAsync<PagedResult<Product>>(
                    $"api/products?pageSize=100&page={page}");

                if (result?.Items != null)
                    allProducts.AddRange(result.Items);

                page++;
            }
            while (result != null && result.HasNextPage);

            products = allProducts.ToArray();

            categories = await Http.GetFromJsonAsync<Category[]>("api/categories");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur de chargement: {ex.Message}");
            NotificationService.ShowError("Erreur lors du chargement des données");
        }
    }

    private void ShowAddForm()
    {
        editingProduct = new Product();
        hasDiscount = false;
        showForm = true;
    }

    private void EditProduct(Product product)
    {
        editingProduct = new Product
        {
            Id               = product.Id,
            Name             = product.Name,
            Description      = product.Description,
            Price            = product.Price,
            CategoryId       = product.CategoryId,
            Stock            = product.Stock,
            ImageUrl         = product.ImageUrl,
            IsAvailable      = product.IsAvailable,
            CreatedAt        = product.CreatedAt,
            DiscountPrice    = product.DiscountPrice,
            DiscountEndDate  = product.DiscountEndDate,
        };
        hasDiscount = editingProduct.DiscountPrice.HasValue;
        showForm = true;
    }

    private void ToggleDiscount(ChangeEventArgs e)
    {
        hasDiscount = (bool)(e.Value ?? false);
        if (!hasDiscount && editingProduct != null)
        {
            editingProduct.DiscountPrice = null;
            editingProduct.DiscountEndDate = null;
        }
    }

    private void CloseForm()
    {
        editingProduct = null;
        showForm = false;
    }

    private void RemoveImage()
    {
        if (editingProduct != null)
        {
            editingProduct.ImageUrl = "/images/products/default.jpg";
        }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        isUploadingImage = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var content = new MultipartFormDataContent();
                using var fileStream = file.OpenReadStream(maxAllowedSize: 5_000_000);
                using var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/products/upload-image", content);

                if (response.IsSuccessStatusCode)
                {
                    var imageUrl = await response.Content.ReadAsStringAsync();
                    editingProduct!.ImageUrl = imageUrl.Trim('"');
                    NotificationService.ShowSuccess("Image uploadée avec succès");
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de l'upload de l'image");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'upload de l'image");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    // ── CATÉGORIES ───────────────────────────────────────────────
    private void OpenCategoryManager()
    {
        showCategoryForm = false;
        showCategoryModal = true;
    }

    private void CloseCategoryManager()
    {
        showCategoryModal = false;
        showCategoryForm = false;
    }

    private void NewCategoryForm()
    {
        editingCategory = new Category();
        showCategoryForm = true;
    }

    private void EditCategoryForm(Category category)
    {
        editingCategory = new Category
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            ImageUrl = category.ImageUrl,
        };
        showCategoryForm = true;
    }

    private void RemoveCategoryImage()
    {
        if (editingCategory != null)
        {
            editingCategory.ImageUrl = string.Empty;
        }
    }

    private async Task HandleCategoryImageSelected(InputFileChangeEventArgs e)
    {
        isUploadingCategoryImage = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var content = new MultipartFormDataContent();
                using var fileStream = file.OpenReadStream(maxAllowedSize: 5_000_000);
                using var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/categories/upload-image", content);

                if (response.IsSuccessStatusCode)
                {
                    var imageUrl = await response.Content.ReadAsStringAsync();
                    editingCategory!.ImageUrl = imageUrl.Trim('"');
                    NotificationService.ShowSuccess("Image uploadée avec succès");
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de l'upload de l'image");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'upload de l'image");
        }
        finally
        {
            isUploadingCategoryImage = false;
        }
    }

    private async Task SaveCategory()
    {
        if (editingCategory == null) return;

        isSavingCategory = true;
        try
        {
            HttpResponseMessage response = editingCategory.Id > 0
                ? await Http.PutAsJsonAsync($"api/categories/{editingCategory.Id}", editingCategory)
                : await Http.PostAsJsonAsync("api/categories", editingCategory);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess(editingCategory.Id > 0 ? "Catégorie modifiée" : "Catégorie créée");
                showCategoryForm = false;
                categories = await Http.GetFromJsonAsync<Category[]>("api/categories");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowError($"Erreur: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'enregistrement de la catégorie");
        }
        finally
        {
            isSavingCategory = false;
        }
    }

    private async Task SaveProduct()
    {
        if (hasDiscount && editingProduct!.DiscountPrice.HasValue && editingProduct.DiscountPrice.Value >= editingProduct.Price)
        {
            NotificationService.ShowError("Le prix promotionnel doit être inférieur au prix normal");
            return;
        }

        isSaving = true;
        try
        {
            HttpResponseMessage response;

            // Si une date de fin de remise est choisie, on l'étend jusqu'à la fin de la journée
            // sélectionnée (23h59) pour que la remise reste valable toute la journée choisie.
            if (hasDiscount && editingProduct!.DiscountEndDate.HasValue)
            {
                editingProduct.DiscountEndDate = editingProduct.DiscountEndDate.Value.Date.AddDays(1).AddSeconds(-1);
            }
            else if (!hasDiscount)
            {
                editingProduct!.DiscountPrice = null;
                editingProduct.DiscountEndDate = null;
            }

            if (editingProduct!.Id == 0)
            {
                response = await Http.PostAsJsonAsync("api/products", editingProduct);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/products/{editingProduct.Id}", editingProduct);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Produit enregistré avec succès");
                CloseForm();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowError($"Erreur: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'enregistrement");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteProduct(Product product)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer '{product.Name}' ?\n\nCette action est irréversible."))
        {
            try
            {
                var response = await Http.DeleteAsync($"api/products/{product.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.ShowSuccess("Produit supprimé avec succès");
                    await LoadData();
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de la suppression");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur: {ex.Message}");
                NotificationService.ShowError("Erreur lors de la suppression");
            }
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NotificationService.ShowSuccess("Déconnexion réussie");
    }
}

