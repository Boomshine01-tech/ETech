@page "/admin/products"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject AuthenticationService AuthService
@inject IJSRuntime JS
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Json
@using System.Net.Http.Headers

<PageTitle>Administration - Produits</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="admin-header">
        <div class="container">
            <div class="header-content">
                <h1><i class="fas fa-cog"></i> Gestion des Produits</h1>
                <div class="user-info">
                    <span>Connecté en tant que: <strong>@currentUsername</strong></span>
                    <button class="btn btn-logout" @onclick="Logout">
                        <i class="fas fa-sign-out-alt"></i> Déconnexion
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-container">
        <div class="admin-actions">
            <button class="btn btn-add" @onclick="ShowAddForm">
                <i class="fas fa-plus"></i> Ajouter un Produit
            </button>
        </div>

        @if (showForm)
        {
            <div class="product-form-card">
                <div class="form-header">
                    <h2>@(editingProduct?.Id > 0 ? "Modifier" : "Nouveau") Produit</h2>
                    <button class="btn-close" @onclick="CloseForm">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                
                <EditForm Model="@editingProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />

                    <div class="form-row">
                        <div class="form-group">
                            <label>Nom du produit *</label>
                            <InputText class="form-control" @bind-Value="editingProduct!.Name" />
                            <ValidationMessage For="@(() => editingProduct.Name)" />
                        </div>

                        <div class="form-group">
                            <label>Prix (FCFA) *</label>
                            <InputNumber class="form-control" @bind-Value="editingProduct.Price" />
                            <ValidationMessage For="@(() => editingProduct.Price)" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Catégorie *</label>
                            <InputSelect class="form-control" @bind-Value="editingProduct.CategoryId">
                                <option value="0">-- Sélectionner --</option>
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => editingProduct.CategoryId)" />
                        </div>

                        <div class="form-group">
                            <label>Stock *</label>
                            <InputNumber class="form-control" @bind-Value="editingProduct.Stock" />
                            <ValidationMessage For="@(() => editingProduct.Stock)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description *</label>
                        <InputTextArea class="form-control" @bind-Value="editingProduct.Description" rows="3" />
                        <ValidationMessage For="@(() => editingProduct.Description)" />
                    </div>

                    <div class="form-group">
                        <label>Image du produit</label>
                        <div class="image-upload-container">
                            <InputFile OnChange="HandleImageSelected" class="file-input" id="imageUpload" accept="image/*" />
                            <label for="imageUpload" class="file-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                Choisir une image
                            </label>
                            
                            @if (isUploadingImage)
                            {
                                <div class="upload-progress">
                                    <i class="fas fa-spinner fa-spin"></i> Upload en cours...
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(editingProduct.ImageUrl))
                            {
                                <div class="image-preview">
                                    <img src="@editingProduct.ImageUrl" alt="Aperçu" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-save" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin"></i> <text>Enregistrement...</text>
                            }
                            else
                            {
                                <i class="fas fa-save"></i> <text>Enregistrer</text>
                            }
                        </button>
                        <button type="button" class="btn btn-cancel" @onclick="CloseForm">
                            Annuler
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="products-table-card">
            @if (products == null)
            {
                <div class="loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Chargement des produits...</p>
                </div>
            }
            else if (products.Length == 0)
            {
                <div class="empty-state">
                    <i class="fas fa-box-open fa-3x"></i>
                    <p>Aucun produit pour le moment</p>
                </div>
            }
            else
            {
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Nom</th>
                            <th>Catégorie</th>
                            <th>Prix</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr>
                                <td>
                                    <img src="@product.ImageUrl" alt="@product.Name" class="product-thumb" />
                                </td>
                                <td>@product.Name</td>
                                <td>@product.Category?.Name</td>
                                <td>@product.Price.ToString("N0") FCFA</td>
                                <td>
                                    <span class="stock-badge @(product.Stock > 0 ? "in-stock" : "out-of-stock")">
                                        @product.Stock
                                    </span>
                                </td>
                                <td>
                                    <button class="btn-action btn-edit" @onclick="() => EditProduct(product)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-action btn-delete" @onclick="() => DeleteProduct(product)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</AuthGuard>

@code {
    private Product[]? products;
    private Category[]? categories;
    private Product? editingProduct;
    private bool showForm = false;
    private bool isSaving = false;
    private bool isUploadingImage = false;
    private string? currentUsername;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadData();
    }

    private async Task LoadCurrentUser()
    {
        var (username, _, _) = await AuthService.GetCurrentUserAsync();
        currentUsername = username ?? "Admin";
    }

    private async Task LoadData()
    {
        try
        {
            // Charger les produits
            var response = await Http.GetAsync("api/products");
            if (response.IsSuccessStatusCode)
            {
                products = await response.Content.ReadFromJsonAsync<Product[]>();
            }
            
            // Charger les catégories
            categories = await Http.GetFromJsonAsync<Category[]>("api/categories");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur de chargement: {ex.Message}");
            NotificationService.ShowError("Erreur lors du chargement des données");
        }
    }

    private void ShowAddForm()
    {
        editingProduct = new Product();
        showForm = true;
    }

    private void EditProduct(Product product)
    {
        editingProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            CategoryId = product.CategoryId,
            Stock = product.Stock,
            ImageUrl = product.ImageUrl,
            IsAvailable = product.IsAvailable
        };
        showForm = true;
    }

    private void CloseForm()
    {
        editingProduct = null;
        showForm = false;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        isUploadingImage = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                // Créer le contenu multipart
                using var content = new MultipartFormDataContent();
                using var fileStream = file.OpenReadStream(maxAllowedSize: 5_000_000); // 5MB max
                using var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                // Upload l'image
                var response = await Http.PostAsync("api/products/upload-image", content);
                
                if (response.IsSuccessStatusCode)
                {
                    var imageUrl = await response.Content.ReadAsStringAsync();
                    editingProduct!.ImageUrl = imageUrl.Trim('"');
                    NotificationService.ShowSuccess("Image uploadée avec succès");
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de l'upload de l'image");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'upload de l'image");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task SaveProduct()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage response;
            
            if (editingProduct!.Id == 0)
            {
                // Création
                response = await Http.PostAsJsonAsync("api/products", editingProduct);
            }
            else
            {
                // Modification
                response = await Http.PutAsJsonAsync($"api/products/{editingProduct.Id}", editingProduct);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Produit enregistré avec succès");
                CloseForm();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowError($"Erreur: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'enregistrement");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteProduct(Product product)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Supprimer le produit '{product.Name}' ?"))
        {
            try
            {
                var response = await Http.DeleteAsync($"api/products/{product.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    NotificationService.ShowSuccess("Produit supprimé");
                    await LoadData();
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de la suppression");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur: {ex.Message}");
                NotificationService.ShowError("Erreur lors de la suppression");
            }
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NotificationService.ShowSuccess("Déconnexion réussie");
    }
}

<!-- Styles restent les mêmes que l'original, on ajoute juste les styles pour le header -->
<style>
    .admin-header .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-info span {
        color: white;
        font-size: 0.9rem;
    }

    .user-info strong {
        color: #fbbf24;
    }

    .btn-logout {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-logout:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
    }

    /* Tous les autres styles de l'Admin.razor original restent identiques */
</style>
