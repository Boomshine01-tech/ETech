@page "/admin/partners"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject AuthenticationService AuthService
@inject IJSRuntime JS
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Headers

<PageTitle>Administration - Partenaires</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="admin-header">
        <div class="container">
            <div class="header-content">
                <div class="header-left">
                    <i class="fas fa-handshake"></i>
                    <div>
                        <h1>Gestion des Partenaires</h1>
                        <p class="subtitle">Gérez les partenaires affichés sur la page d'accueil</p>
                    </div>
                </div>
                <div class="user-info">
                    <div class="user-avatar"><i class="fas fa-user-shield"></i></div>
                    <div class="user-details">
                        <span class="username">@currentUsername</span>
                        <span class="role">Administrateur</span>
                    </div>
                    <button class="btn-logout" @onclick="Logout" title="Déconnexion">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
            <div class="admin-subnav">
                <a href="/admin/products" class="subnav-link"><i class="fas fa-boxes"></i> Produits</a>
                <a href="/admin/formations" class="subnav-link"><i class="fas fa-graduation-cap"></i> Formations</a>
                <a href="/admin/announcement" class="subnav-link"><i class="fas fa-bullhorn"></i> Bande d'annonce</a>
                <a href="/admin/realisations" class="subnav-link"><i class="fas fa-images"></i> Réalisations</a>
                <a href="/admin/partners" class="subnav-link active"><i class="fas fa-handshake"></i> Partenaires</a>
            </div>
        </div>
    </div>

    <div class="admin-container">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Chargement...</p>
            </div>
        }
        else
        {
            <div class="toolbar">
                <p class="toolbar-hint">
                    <i class="fas fa-circle-info"></i>
                    Ces partenaires apparaissent dans la section "Nos partenaires" de la page d'accueil, juste en dessous des témoignages. Utilisez les flèches pour changer leur ordre d'affichage.
                </p>
                <button class="btn-primary" @onclick="OpenCreate">
                    <i class="fas fa-plus"></i> Nouveau partenaire
                </button>
            </div>

            @if (!partners.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-handshake"></i>
                    <p>Aucun partenaire pour le moment. Ajoutez-en un pour commencer.</p>
                </div>
            }

            <div class="partners-grid">
                @foreach (var partner in partners)
                {
                    <div class="partner-tile @(!partner.IsActive ? "partner-tile-inactive" : "")">
                        <div class="partner-tile-logo">
                            <img src="@partner.LogoUrl" alt="@partner.Name" />
                        </div>
                        <div class="partner-tile-info">
                            <strong>@partner.Name</strong>
                            @if (!partner.IsActive)
                            {
                                <span class="badge badge-inactive">Masqué</span>
                            }
                        </div>
                        <div class="partner-tile-actions">
                            <button class="btn-icon" title="Monter" @onclick='() => MovePartner(partner.Id, "up")'><i class="fas fa-arrow-up"></i></button>
                            <button class="btn-icon" title="Descendre" @onclick='() => MovePartner(partner.Id, "down")'><i class="fas fa-arrow-down"></i></button>
                            <button class="btn-icon" title="Modifier" @onclick="() => OpenEdit(partner)"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon btn-icon-danger" title="Supprimer" @onclick="() => DeletePartner(partner)"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                }
                <button class="add-partner-tile" @onclick="OpenCreate">
                    <i class="fas fa-plus"></i>
                    <span>Ajouter un partenaire</span>
                </button>
            </div>
        }
    </div>
</AuthGuard>

<!-- ═══════════ MODAL PARTENAIRE (créer / modifier) ═══════════ -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Modifier le partenaire" : "Nouveau partenaire")</h2>
                <button class="btn-close" @onclick="CloseModal"><i class="fas fa-times"></i></button>
            </div>

            <EditForm Model="@currentPartner" OnValidSubmit="SavePartner">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Nom du partenaire <span class="required">*</span></label>
                            <InputText class="form-input" @bind-Value="currentPartner.Name" placeholder="Ex: ARLA France" />
                            <ValidationMessage For="@(() => currentPartner.Name)" />
                        </div>

                        <div class="form-group full-width">
                            <label>Logo <span class="required">*</span></label>
                            <div class="image-upload-zone">
                                @if (string.IsNullOrEmpty(currentPartner.LogoUrl))
                                {
                                    <label for="partnerLogoUpload" class="upload-label">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <p>Cliquez pour choisir un logo</p>
                                        <span class="upload-hint">PNG, JPG ou WEBP (max. 5MB) — fond transparent recommandé</span>
                                    </label>
                                }
                                else
                                {
                                    <div class="image-preview-container logo-preview-container">
                                        <img src="@currentPartner.LogoUrl" alt="Aperçu" class="image-preview logo-preview" />
                                        <button type="button" class="btn-remove-image" @onclick="RemoveLogo">
                                            <i class="fas fa-times"></i>
                                        </button>
                                        <label for="partnerLogoUpload" class="btn-change-image">
                                            <i class="fas fa-sync-alt"></i> Changer le logo
                                        </label>
                                    </div>
                                }
                                <InputFile OnChange="HandleLogoSelected" class="file-input" id="partnerLogoUpload" accept="image/*" />
                                @if (isUploadingLogo)
                                {
                                    <div class="upload-progress">
                                        <div class="progress-bar"><div class="progress-fill"></div></div>
                                        <p>Upload en cours...</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group full-width">
                            <label>Description (optionnel)</label>
                            <InputTextArea class="form-textarea" @bind-Value="currentPartner.Description"
                                          rows="2" placeholder="Ex: Fournisseur officiel de panneaux solaires..." />
                            <ValidationMessage For="@(() => currentPartner.Description)" />
                        </div>

                        <div class="form-group full-width">
                            <label>Site web (optionnel)</label>
                            <InputText class="form-input" @bind-Value="currentPartner.WebsiteUrl" placeholder="https://..." />
                            <p class="hint">Si renseigné, le logo devient cliquable sur la page d'accueil.</p>
                            <ValidationMessage For="@(() => currentPartner.WebsiteUrl)" />
                        </div>

                        <div class="form-group full-width">
                            <label class="checkbox-label-inline">
                                <InputCheckbox @bind-Value="currentPartner.IsActive" />
                                Afficher ce partenaire sur la page d'accueil
                            </label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button type="submit" class="btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <i class="fas fa-spinner fa-spin"></i> <text>Enregistrement...</text>
                        }
                        else
                        {
                            <i class="fas fa-save"></i> @(isEditing ? "Modifier" : "Créer")
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Partner> partners = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isUploadingLogo = false;
    private string currentUsername = "";

    private bool showModal = false;
    private bool isEditing = false;
    private Partner currentPartner = new();

    protected override async Task OnInitializedAsync()
    {
        var (username, _, _) = await AuthService.GetCurrentUserAsync();
        currentUsername = username ?? "Admin";
        await LoadPartners();
    }

    private async Task LoadPartners()
    {
        isLoading = true;
        try
        {
            partners = await Http.GetFromJsonAsync<List<Partner>>("api/partners/admin") ?? new();
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Erreur lors du chargement des partenaires");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreate()
    {
        currentPartner = new Partner { IsActive = true };
        isEditing = false;
        showModal = true;
    }

    private void OpenEdit(Partner partner)
    {
        currentPartner = new Partner
        {
            Id = partner.Id,
            Name = partner.Name,
            LogoUrl = partner.LogoUrl,
            Description = partner.Description,
            WebsiteUrl = partner.WebsiteUrl,
            DisplayOrder = partner.DisplayOrder,
            IsActive = partner.IsActive
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void RemoveLogo()
    {
        currentPartner.LogoUrl = string.Empty;
    }

    private async Task HandleLogoSelected(InputFileChangeEventArgs e)
    {
        isUploadingLogo = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var content = new MultipartFormDataContent();
                using var fileStream = file.OpenReadStream(maxAllowedSize: 5_000_000);
                using var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/partners/upload-image", content);

                if (response.IsSuccessStatusCode)
                {
                    var imageUrl = await response.Content.ReadAsStringAsync();
                    currentPartner.LogoUrl = imageUrl.Trim('"');
                    NotificationService.ShowSuccess("Logo uploadé avec succès");
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de l'upload du logo");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'upload du logo");
        }
        finally
        {
            isUploadingLogo = false;
        }
    }

    private async Task SavePartner()
    {
        if (string.IsNullOrWhiteSpace(currentPartner.LogoUrl))
        {
            NotificationService.ShowError("Merci d'ajouter un logo avant d'enregistrer");
            return;
        }

        isSaving = true;
        try
        {
            var response = isEditing
                ? await Http.PutAsJsonAsync($"api/partners/{currentPartner.Id}", currentPartner)
                : await Http.PostAsJsonAsync("api/partners", currentPartner);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess(isEditing ? "Partenaire modifié" : "Partenaire créé");
                showModal = false;
                await LoadPartners();
            }
            else
            {
                NotificationService.ShowError("Erreur lors de l'enregistrement");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Erreur lors de l'enregistrement");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePartner(Partner partner)
    {
        if (!await ConfirmAsync($"Supprimer le partenaire « {partner.Name} » ? Cette action est irréversible."))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/partners/{partner.Id}");
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Partenaire supprimé");
                await LoadPartners();
            }
            else
            {
                NotificationService.ShowError("Erreur lors de la suppression");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Erreur lors de la suppression");
            Console.WriteLine(ex.Message);
        }
    }

    private async Task MovePartner(int id, string direction)
    {
        try
        {
            var response = await Http.PostAsync($"api/partners/{id}/move?direction={direction}", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadPartners();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NotificationService.ShowSuccess("Déconnexion réussie");
    }
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: white;
        padding: 2rem 0 0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1.5rem;
    }

    .header-left { display: flex; align-items: center; gap: 1.5rem; }
    .header-left i { font-size: 2.5rem; color: #fbbf24; }
    .header-left h1 { margin: 0; font-size: 1.6rem; }
    .subtitle { margin: 0.25rem 0 0; opacity: 0.85; font-size: 0.9rem; }

    .user-info { display: flex; align-items: center; gap: 0.75rem; }
    .user-avatar {
        width: 40px; height: 40px; border-radius: 50%;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
    }
    .user-details { display: flex; flex-direction: column; line-height: 1.2; }
    .username { font-weight: 600; }
    .role { font-size: 0.75rem; opacity: 0.8; }

    .btn-logout {
        background: rgba(255,255,255,0.15);
        border: none; color: white;
        width: 38px; height: 38px; border-radius: 8px;
        cursor: pointer; transition: background 0.3s;
    }
    .btn-logout:hover { background: rgba(255,255,255,0.3); }

    .admin-subnav { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .subnav-link {
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        padding: 0.6rem 1rem;
        border-radius: 8px 8px 0 0;
        font-size: 0.9rem; font-weight: 500;
        display: inline-flex; align-items: center; gap: 0.4rem;
        transition: all 0.2s;
    }
    .subnav-link:hover { background: rgba(255,255,255,0.1); color: white; }
    .subnav-link.active { background: #f7f8fa; color: #1e3a8a; }

    .admin-container { max-width: 1400px; margin: 0 auto; padding: 2rem; }

    .toolbar {
        display: flex; justify-content: space-between; align-items: center;
        gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;
    }
    .toolbar-hint {
        font-size: 0.85rem; color: #6b7280;
        display: flex; align-items: center; gap: 0.5rem;
        max-width: 640px;
    }
    .toolbar-hint i { color: #3b82f6; }

    .btn-primary {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        color: white; border: none;
        padding: 0.7rem 1.5rem; border-radius: 8px;
        font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5rem;
        transition: opacity 0.2s; white-space: nowrap;
    }
    .btn-primary:hover:not(:disabled) { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-secondary {
        background: #f3f4f6; color: #374151; border: none;
        padding: 0.7rem 1.5rem; border-radius: 8px;
        font-weight: 600; cursor: pointer; transition: background 0.2s;
    }
    .btn-secondary:hover { background: #e5e7eb; }

    /* ===== GRILLE DES PARTENAIRES ===== */
    .partners-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }

    .partner-tile {
        position: relative;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: box-shadow 0.2s;
    }
    .partner-tile:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
    .partner-tile-inactive { opacity: 0.6; }

    .partner-tile-logo {
        height: 110px;
        display: flex; align-items: center; justify-content: center;
        padding: 1rem;
        background: #f9fafb;
        border-bottom: 1px solid #f3f4f6;
    }
    .partner-tile-logo img {
        max-width: 100%; max-height: 100%;
        object-fit: contain;
    }

    .partner-tile-info {
        padding: 0.65rem 0.85rem;
        display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    }
    .partner-tile-info strong {
        font-size: 0.85rem; color: #1f2937;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .partner-tile-actions {
        display: flex; gap: 0.3rem;
        padding: 0 0.65rem 0.65rem;
        flex-wrap: wrap;
    }

    .btn-icon {
        width: 30px; height: 30px; border-radius: 6px; border: none;
        background: #f3f4f6; color: #4b5563; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s; font-size: 0.75rem;
    }
    .btn-icon:hover { background: #e5e7eb; }
    .btn-icon-danger:hover { background: #fee2e2; color: #dc2626; }

    .badge {
        display: inline-flex; align-items: center;
        padding: 0.15rem 0.5rem; border-radius: 999px;
        font-size: 0.65rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.03em;
        flex-shrink: 0;
    }
    .badge-inactive { background: #fee2e2; color: #dc2626; }

    .add-partner-tile {
        min-height: 178px;
        border-radius: 12px;
        border: 2px dashed #d1d5db;
        background: white;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 0.5rem; color: #9ca3af; cursor: pointer;
        transition: all 0.2s; font-size: 0.82rem; font-weight: 600;
    }
    .add-partner-tile:hover { border-color: #3b82f6; color: #3b82f6; background: rgba(59,130,246,0.04); }
    .add-partner-tile i { font-size: 1.4rem; }

    .empty-state { text-align: center; padding: 4rem 2rem; color: #9ca3af; }
    .empty-state i { font-size: 2.5rem; margin-bottom: 1rem; display: block; }

    .loading-state { text-align: center; padding: 4rem 2rem; color: #6b7280; }
    .spinner {
        border: 3px solid #e5e7eb; border-top-color: #3b82f6;
        border-radius: 50%; width: 40px; height: 40px;
        animation: spin 1s linear infinite; margin: 0 auto 1rem;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ===== MODAL ===== */
    .modal-overlay {
        position: fixed; inset: 0;
        background: rgba(15, 23, 42, 0.6);
        display: flex; align-items: center; justify-content: center;
        z-index: 1000; padding: 1rem;
    }
    .modal-content {
        background: white; border-radius: 14px;
        max-width: 520px; width: 100%; max-height: 90vh;
        overflow-y: auto; box-shadow: 0 24px 60px rgba(0,0,0,0.3);
    }
    .modal-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 1.5rem; border-bottom: 1px solid #e5e7eb;
        position: sticky; top: 0; background: white; z-index: 2;
    }
    .modal-header h2 { margin: 0; font-size: 1.15rem; color: #1f2937; }
    .btn-close {
        background: #f3f4f6; border: none; width: 32px; height: 32px;
        border-radius: 8px; cursor: pointer; color: #6b7280;
    }
    .btn-close:hover { background: #e5e7eb; }
    .modal-body { padding: 1.5rem; }
    .modal-footer {
        display: flex; justify-content: flex-end; gap: 0.75rem;
        padding: 1.1rem 1.5rem; border-top: 1px solid #e5e7eb;
    }

    /* ===== FORMS ===== */
    .form-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; margin-bottom: 1rem; }
    .form-group.full-width { grid-column: 1 / -1; }
    .form-group label { font-weight: 600; color: #374151; font-size: 0.85rem; margin-bottom: 0.35rem; }
    .required { color: #dc2626; }
    .form-input, .form-textarea {
        width: 100%; padding: 0.6rem; border: 2px solid #e5e7eb;
        border-radius: 6px; font-size: 0.9rem; transition: border-color 0.3s;
        font-family: inherit;
    }
    .form-input:focus, .form-textarea:focus { outline: none; border-color: #3b82f6; }
    .form-textarea { resize: vertical; }
    .hint { margin: 0.3rem 0 0; font-size: 0.76rem; color: #9ca3af; }

    .checkbox-label-inline {
        display: flex !important; flex-direction: row !important;
        align-items: center; gap: 0.5rem; font-weight: 500 !important;
        cursor: pointer; margin-bottom: 0.6rem;
    }

    /* ===== UPLOAD DU LOGO ===== */
    .image-upload-zone { position: relative; }
    .file-input { display: none; }
    .upload-label {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 2rem 1.5rem; border: 2px dashed #d1d5db; border-radius: 10px;
        cursor: pointer; transition: all 0.3s; background: #f9fafb;
    }
    .upload-label:hover { border-color: #3b82f6; background: rgba(59,130,246,0.05); }
    .upload-label i { font-size: 2rem; color: #9ca3af; margin-bottom: 0.6rem; }
    .upload-label p { font-size: 0.95rem; font-weight: 600; color: #374151; margin-bottom: 0.3rem; }
    .upload-hint { font-size: 0.8rem; color: #6b7280; text-align: center; }

    .image-preview-container { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
    .image-preview { width: 100%; max-height: 220px; object-fit: contain; border-radius: 10px; border: 1px solid #e5e7eb; }
    .logo-preview-container { background: #f9fafb; border-radius: 10px; padding: 1rem; }
    .logo-preview { max-height: 140px; }

    .btn-remove-image {
        position: absolute; top: 0.5rem; right: 0.5rem;
        width: 28px; height: 28px; background: rgba(239,68,68,0.9); color: white;
        border: none; border-radius: 6px; cursor: pointer;
        display: flex; align-items: center; justify-content: center; transition: all 0.3s;
    }
    .btn-remove-image:hover { background: #ef4444; transform: scale(1.1); }

    .btn-change-image {
        padding: 0.4rem 0.9rem; background: #f3f4f6; color: #374151;
        border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.4rem; transition: all 0.3s;
    }
