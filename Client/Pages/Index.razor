<script>
        (function() {
            // ===== 1. MORPHING CANVAS =====
            const canvas = document.getElementById('morphingCanvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                let width, height;
                let time = 0;
                
                function resize() {
                    width = window.innerWidth;
                    height = window.innerHeight;
                    canvas.width = width;
                    canvas.height = height;
                }
                
                function drawMorphing() {
                    if (!ctx) return;
                    ctx.clearRect(0, 0, width, height);
                    
                    const gradient = ctx.createLinearGradient(0, 0, width, height);
                    gradient.addColorStop(0, '#1e3a8a');
                    gradient.addColorStop(0.5, '#2563eb');
                    gradient.addColorStop(1, '#3b82f6');
                    ctx.fillStyle = gradient;
                    ctx.fillRect(0, 0, width, height);
                    
                    const centerX = width / 2;
                    const centerY = height / 2;
                    
                    for (let i = 0; i < 12; i++) {
                        ctx.beginPath();
                        const angle = (i / 12) * Math.PI * 2 + time * 0.3;
                        const radius = 150 + Math.sin(time * 0.5 + i) * 30;
                        const x = centerX + Math.cos(angle) * radius;
                        const y = centerY + Math.sin(angle) * radius;
                        
                        for (let j = 0; j < 30; j++) {
                            const subAngle = angle + (j / 30) * Math.PI * 2;
                            const subRadius = radius + Math.sin(time * 2 + subAngle * 3) * 40;
                            const px = centerX + Math.cos(subAngle) * subRadius;
                            const py = centerY + Math.sin(subAngle) * subRadius;
                            
                            ctx.fillStyle = `rgba(245, 166, 35, ${0.1 + Math.sin(time * 2 + i) * 0.05})`;
                            ctx.beginPath();
                            ctx.arc(px, py, 4 + Math.sin(time * 3 + i) * 2, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }
                    
                    time += 0.02;
                    requestAnimationFrame(drawMorphing);
                }
                
                window.addEventListener('resize', resize);
                resize();
                drawMorphing();
            }
            
            // ===== 2. STATS QUI EXPLOSENT =====
            const stats = document.querySelectorAll('.stat-explode');
            
            function animateNumber(el, target) {
                let current = 0;
                const increment = target / 60;
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        el.textContent = target;
                        clearInterval(timer);
                        el.parentElement?.parentElement?.classList.add('exploded');
                    } else {
                        el.textContent = Math.floor(current);
                    }
                }, 20);
            }
            
            const statsObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const numberEl = entry.target.querySelector('.stat-number');
                        const target = parseInt(entry.target.dataset.target);
                        if (numberEl && target) animateNumber(numberEl, target);
                        statsObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });
            
            stats.forEach(stat => statsObserver.observe(stat));
            
            // ===== 3. GALERIE 360° QUI TOURNE =====
            const track = document.getElementById('gallery360Track');
            const prevBtn = document.querySelector('.gallery-prev');
            const nextBtn = document.querySelector('.gallery-next');
            let currentIndex360 = 0;
            const items360 = document.querySelectorAll('.gallery-360-item');
            const totalItems360 = items360.length;
            let itemWidth = 300;
            
            function updateGallery() {
                if (!track) return;
                track.style.transform = `translateX(-${currentIndex360 * itemWidth}px)`;
            }
            
            function nextGallery() {
                currentIndex360 = (currentIndex360 + 1) % totalItems360;
                updateGallery();
            }
            
            function prevGallery() {
                currentIndex360 = (currentIndex360 - 1 + totalItems360) % totalItems360;
                updateGallery();
            }
            
            if (prevBtn) prevBtn.addEventListener('click', prevGallery);
            if (nextBtn) nextBtn.addEventListener('click', nextGallery);
            
            setInterval(nextGallery, 4000);
            
            // ===== 4. TÉMOIGNAGES EN VAGUE =====
            const waveTrack = document.getElementById('waveTrack');
            let waveIndex = 0;
            const waveItems = document.querySelectorAll('.testimonial-wave-card');
            const waveTotal = waveItems.length;
            
            function updateWave() {
                if (!waveTrack) return;
                waveTrack.style.transform = `translateX(-${waveIndex * 100}%)`;
            }
            
            function nextWave() {
                waveIndex = (waveIndex + 1) % waveTotal;
                updateWave();
            }
            
            setInterval(nextWave, 5000);
            
            // ===== 5. SERVICES 3D AU SURVOL =====
            const serviceCards = document.querySelectorAll('.service-3d-card');
            serviceCards.forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    const rotateX = y * 20;
                    const rotateY = x * 20;
                    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(20px)`;
                });
                
                card.addEventListener('mouseleave', () => {
                    card.style.transform = '';
                });
            });
            
            // ===== 6. TITRE ANIMÉ =====
            const titleWords = document.querySelectorAll('.title-word');
            titleWords.forEach((word, i) => {
                word.style.animation = `titleGlow 2s ease-in-out ${i * 0.3}s infinite`;
            });
            
            // ===== 7. SCROLL REVEAL =====
            const revealElements = document.querySelectorAll('.service-3d-card, .gallery-360-item, .testimonial-wave-card');
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0) scale(1)';
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });
            
            revealElements.forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(50px) scale(0.9)';
                el.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                revealObserver.observe(el);
            });
        })();
    </script>

<style>
/* ===== STYLES PRINCIPAUX ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: #0a0f1c;
    overflow-x: hidden;
}

/* ===== HERO MORPHING ===== */
.hero-morphing {
    position: relative;
    height: 100vh;
    overflow: hidden;
}

#morphingCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, transparent 0%, rgba(10,15,28,0.6) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 20px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    padding: 8px 24px;
    border-radius: 60px;
    color: #f5a623;
    font-weight: 600;
    margin-bottom: 30px;
    position: relative;
}

.badge-ring {
    position: absolute;
    inset: -2px;
    border-radius: 60px;
    border: 1px solid rgba(245,166,35,0.5);
    animation: ringPulse 2s infinite;
}

@@keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
}

.floating-badge {
    animation: floatBadge 3s infinite ease-in-out;
}

@@keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
}

.hero-title {
    font-size: clamp(2rem, 8vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 40px;
    line-height: 1.2;
}

.title-word {
    display: inline-block;
    color: white;
    margin: 0 10px;
    animation: titleGlow 2s ease-in-out infinite;
}

@@keyframes titleGlow {
    0%, 100% { text-shadow: 0 0 5px rgba(245,166,35,0.3); }
    50% { text-shadow: 0 0 20px rgba(245,166,35,0.8), 0 0 30px rgba(245,166,35,0.4); }
}

.title-word.accent {
    color: #f5a623;
}

.hero-cta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 60px;
}

.cta-btn-primary, .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 32px;
    border-radius: 60px;
    text-decoration: none;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
}

.cta-btn-primary {
    background: #f5a623;
    color: #0a0f1c;
}

.cta-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(245,166,35,0.4);
}

.btn-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.5s;
}

.cta-btn-primary:hover .btn-glow {
    left: 100%;
}

.cta-btn-secondary {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
}

.cta-btn-secondary:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-2px);
}

.hero-scroll {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    animation: bounce 2s infinite;
}

@@keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
}

.scroll-mouse {
    width: 26px;
    height: 40px;
    border: 2px solid white;
    border-radius: 20px;
    display: flex;
    justify-content: center;
}

.scroll-wheel {
    width: 3px;
    height: 8px;
    background: white;
    border-radius: 2px;
    margin-top: 6px;
    animation: scrollWheel 1.5s infinite;
}

@@keyframes scrollWheel {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(15px); }
}

.hero-scroll span {
    color: rgba(255,255,255,0.6);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

/* ===== STATS EXPLOSION ===== */
.stats-explosion {
    padding: 80px 20px;
    background: #0f1420;
}

.stats-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
}

.stat-explode {
    text-align: center;
    padding: 30px;
    background: linear-gradient(135deg, rgba(30,58,138,0.3), rgba(37,99,235,0.1));
    border-radius: 24px;
    border: 1px solid rgba(59,130,246,0.2);
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
}

.stat-explode:hover {
    transform: translateY(-5px);
    border-color: rgba(245,166,35,0.5);
}

.stat-number-wrapper {
    font-size: 3rem;
    font-weight: 800;
    color: #f5a623;
    font-family: 'Bebas Neue', sans-serif;
}

.stat-number {
    font-size: 3rem;
}

.stat-suffix {
    font-size: 1.5rem;
}

.stat-icon {
    font-size: 2rem;
    color: #3b82f6;
    margin: 15px 0;
}

.stat-label {
    color: rgba(255,255,255,0.7);
    font-size: 0.85rem;
}

.stat-sparkle {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
}

.stat-explode.exploded .stat-sparkle {
    animation: sparkle 0.5s ease-out;
