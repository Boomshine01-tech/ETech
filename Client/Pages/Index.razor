    </div>
    <div class="slide @(currentSlide == 1 ? "active" : "")" style="background-image: url('https://images.unsplash.com/photo-1621905251918-48416bd8575a?w=1600')">
    </div>
    <div class="slide @(currentSlide == 2 ? "active" : "")" style="background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1600')">
    </div>
    <div class="slide @(currentSlide == 3 ? "active" : "")" style="background-image: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600')">
    </div>
    <div class="slide @(currentSlide == 4 ? "active" : "")" style="background-image: url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=1600')">
    </div>
    <div class="slide @(currentSlide == 5 ? "active" : "")" style="background-image: url('https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?w=1600')">
    </div>

    <div class="hero-grid"></div>

    <!-- Particules décoratives -->
    <div class="particle" style="width:5px;height:5px;left:8%;animation-duration:9s;animation-delay:0s"></div>
    <div class="particle" style="width:4px;height:4px;left:22%;animation-duration:13s;animation-delay:2s"></div>
    <div class="particle" style="width:7px;height:7px;left:48%;animation-duration:11s;animation-delay:4s"></div>
    <div class="particle" style="width:5px;height:5px;left:68%;animation-duration:8s;animation-delay:1s"></div>
    <div class="particle" style="width:6px;height:6px;left:83%;animation-duration:10s;animation-delay:3s"></div>

    <!-- Contenu principal -->
    <div class="hero-content">
        <div class="hero-badge"><i class="fas fa-bolt"></i> Thiès, Sénégal</div>
        <h1>e-Tech <span>Energie+</span></h1>
        <p class="tagline">L'innovation à portée de main</p>
        <p class="subtitle">Performance, fiabilité et évolutivité des solutions technologiques pour votre entreprise</p>
        <meta property="og:image" content="https://etechenergie.onrender.com/images/preview.jpg" />

        <div class="hero-actions">
            <a href="/services" class="btn btn-secondary">
                <i class="fas fa-cogs"></i> Nos Services
            </a>
            <a href="/products" class="btn btn-primary">
                <i class="fas fa-shopping-bag"></i> Boutique
            </a>
            <a href="/contact" class="btn btn-secondary">
                <i class="fas fa-envelope"></i> Contactez-nous
            </a>
        </div>
    </div>

    <!-- Dots de navigation -->
    <div class="slider-dots">
        @for (int i = 0; i < totalSlides; i++)
        {
            var index = i;
            <button class="dot @(currentSlide == index ? "active" : "")" @onclick="() => GoToSlide(index)"></button>
        }
    </div>

    <!-- Barre de progression -->
    <div class="slide-progress">
        <div class="slide-progress-bar" style="transition: width @(slideDuration)ms linear; width: @(progressWidth)%"></div>
    </div>

    <!-- Statistiques -->
    <div class="hero-stats">
        <div class="stat-item">
            <span class="stat-number">200+</span>
            <span class="stat-label">Clients satisfaits</span>
        </div>
        <div class="stat-item">
            <span class="stat-number">5+</span>
