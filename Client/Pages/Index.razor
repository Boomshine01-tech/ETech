@code {
    private Service[]? services;

    // Slider
    private int currentSlide = 0;
    private int totalSlides = 6;
    private int slideDuration = 4000;
    private double progressWidth = 0;
    private System.Threading.Timer? sliderTimer;
    //private bool progressAnimating = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            services = await Http.GetFromJsonAsync<Service[]>("api/services");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des services: {ex.Message}");
        }

        StartSlider();
    }

    private string GetOrganizationSchema()
    {
        return @"{
            ""@context"": ""https://schema.org"",
            ""@type"": ""Organization"",
            ""name"": ""ETech Énergie"",
            ""url"": ""https://etechenergie.onrender.com/"",
            ""logo"": ""https://etechenergie.onrender.com/android-chrome-512x512.png"",
            ""description"": ""Entreprise spécialisée dans les solutions énergétiques la vente de capteur et actionneur électronique et la formation professionnelle."",
            ""contactPoint"": {
                ""@type"": ""ContactPoint"",
                ""telephone"": ""+221-78-805-16-17"",
                ""contactType"": ""customer service""
            }
        }";
    }

    private void StartSlider()
    {
        progressWidth = 0;
        StateHasChanged();

        // Lancer la barre de progression après un court délai
        Task.Delay(50).ContinueWith(_ =>
        {
            progressWidth = 100;
            InvokeAsync(StateHasChanged);
        });

        sliderTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                currentSlide = (currentSlide + 1) % totalSlides;
                progressWidth = 0;
                StateHasChanged();

                Task.Delay(50).ContinueWith(__ =>
                {
                    progressWidth = 100;
                    InvokeAsync(StateHasChanged);
                });
            });
        }, null, slideDuration, slideDuration);
    }

    private void GoToSlide(int index)
    {
        sliderTimer?.Dispose();
        currentSlide = index;
        StartSlider();
    }

    public void Dispose()
    {
        sliderTimer?.Dispose();
    }
}

<style>
    /* ===== HERO ===== */
    .hero {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .slide {
        position: absolute;
