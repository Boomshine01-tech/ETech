@page "/admin/formations"
@inject HttpClient Http
@inject NotificationService NotificationService
@inject AuthenticationService AuthService
@inject IJSRuntime JS
@using ETechEnergie.Shared.Models
@using ETechEnergie.Client.Services
@using System.Net.Http.Headers

<PageTitle>Administration - Formations</PageTitle>

<AuthGuard RequireAdmin="true">
    <div class="admin-header">
        <div class="container">
            <div class="header-content">
                <div class="header-left">
                    <i class="fas fa-graduation-cap"></i>
                    <div>
                        <h1>Gestion des Formations</h1>
                        <p class="subtitle">Gérez vos formations et inscriptions</p>
                    </div>
                </div>
                <div class="user-info">
                    <div class="user-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="user-details">
                        <span class="username">@currentUsername</span>
                        <span class="role">Administrateur</span>
                    </div>
                    <button class="btn-logout" @onclick="Logout" title="Déconnexion">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            </div>
            <div class="admin-subnav">
                <a href="/admin/products" class="subnav-link"><i class="fas fa-boxes"></i> Produits</a>
                <a href="/admin/formations" class="subnav-link active"><i class="fas fa-graduation-cap"></i> Formations</a>
                <a href="/admin/announcement" class="subnav-link"><i class="fas fa-bullhorn"></i> Bande d'annonce</a>
                <a href="/admin/realisations" class="subnav-link"><i class="fas fa-images"></i> Réalisations</a>
            </div>
        </div>
    </div>

    <div class="admin-container">
        <div class="toolbar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Rechercher une formation..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <div class="filter-group">
                <select @bind="statutFilter" class="filter-select">
                    <option value="">Tous les statuts</option>
                    <option value="A venir">À venir</option>
                    <option value="En cours">En cours</option>
                    <option value="Terminée">Terminée</option>
                </select>
            </div>
            <button class="btn-primary" @onclick="ShowAddForm">
                <i class="fas fa-plus"></i>
                <span>Nouvelle Formation</span>
            </button>
        </div>

        @if (formations == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Chargement des formations...</p>
            </div>
        }
        else if (!FilteredFormations.Any())
        {
            <div class="empty-state">
                <i class="fas fa-graduation-cap"></i>
                <h3>Aucune formation trouvée</h3>
                <p>@(string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statutFilter) ? "Commencez par ajouter votre première formation" : "Aucune formation ne correspond à votre recherche")</p>
                @if (string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statutFilter))
                {
                    <button class="btn-primary" @onclick="ShowAddForm">
                        <i class="fas fa-plus"></i> Ajouter une Formation
                    </button>
                }
            </div>
        }
        else
        {
            <div class="formations-grid">
                @foreach (var formation in FilteredFormations)
                {
                    <div class="formation-card">
                        @if (!string.IsNullOrEmpty(formation.ImageUrl))
                        {
                            <div class="formation-thumbnail">
                                <img src="@formation.ImageUrl" alt="@formation.Titre" />
                            </div>
                        }
                        <div class="formation-header">
                            <span class="formation-status @GetStatusClass(formation.Statut)">@formation.Statut</span>
                            <span class="formation-price">@formation.Prix.ToString("N0") FCFA</span>
                        </div>
                        <h3 class="formation-title">@formation.Titre</h3>
                        <p class="formation-description">@formation.Description</p>
                        <div class="formation-details">
                            <div class="detail-item">
                                <i class="fas fa-calendar"></i>
                                <span>@formation.DateDebut.ToString("dd/MM/yyyy") - @formation.DateFin.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-clock"></i>
                                <span>@formation.Horaires</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@formation.Lieu</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-users"></i>
                                <span>@formation.PlacesRestantes / @formation.CapaciteMax places</span>
                            </div>
                        </div>
                        <div class="formation-actions">
                            <button class="btn-view" @onclick="() => ViewInscriptions(formation)" title="Voir les inscriptions">
                                <i class="fas fa-users"></i>
                                <span>@formation.Inscriptions.Count</span>
                            </button>
                            <button class="btn-edit" @onclick="() => EditFormation(formation)" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-delete" @onclick="() => DeleteFormation(formation)" title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- MODAL AJOUT/MODIFICATION -->
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>@(isEditing ? "Modifier la Formation" : "Nouvelle Formation")</h2>
                    <button class="modal-close" @onclick="CloseModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <EditForm Model="@currentFormation" OnValidSubmit="HandleSubmit">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Titre *</label>
                            <InputText @bind-Value="currentFormation.Titre" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.Titre)" />
                        </div>
                        <div class="form-group">
                            <label>Prix (FCFA) *</label>
                            <InputNumber @bind-Value="currentFormation.Prix" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.Prix)" />
                        </div>
                        <div class="form-group full-width">
                            <label>Description *</label>
                            <InputTextArea @bind-Value="currentFormation.Description" class="form-textarea" rows="3" />
                            <ValidationMessage For="@(() => currentFormation.Description)" />
                        </div>
                        <div class="form-group full-width">
                            <label>Affiche de la formation (optionnel)</label>
                            <div class="image-upload-zone">
                                @if (string.IsNullOrEmpty(currentFormation.ImageUrl))
                                {
                                    <label for="formationImageUpload" class="upload-label">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <p>Cliquez pour choisir une image</p>
                                        <span class="upload-hint">PNG, JPG ou WEBP (max. 5MB) — facultatif</span>
                                    </label>
                                }
                                else
                                {
                                    <div class="image-preview-container">
                                        <img src="@currentFormation.ImageUrl" alt="Aperçu" class="image-preview" />
                                        <button type="button" class="btn-remove-image" @onclick="RemoveFormationImage">
                                            <i class="fas fa-times"></i>
                                        </button>
                                        <label for="formationImageUpload" class="btn-change-image">
                                            <i class="fas fa-sync-alt"></i> Changer l'image
                                        </label>
                                    </div>
                                }
                                <InputFile OnChange="HandleImageSelected" class="file-input" id="formationImageUpload" accept="image/*" />
                                @if (isUploadingImage)
                                {
                                    <div class="upload-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill"></div>
                                        </div>
                                        <p>Upload en cours...</p>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Date de début *</label>
                            <InputDate @bind-Value="currentFormation.DateDebut" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.DateDebut)" />
                        </div>
                        <div class="form-group">
                            <label>Date de fin *</label>
                            <InputDate @bind-Value="currentFormation.DateFin" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.DateFin)" />
                        </div>
                        <div class="form-group">
                            <label>Horaires *</label>
                            <InputText @bind-Value="currentFormation.Horaires" class="form-input" placeholder="ex: Tous les dimanches de 09h à 13h" />
                            <ValidationMessage For="@(() => currentFormation.Horaires)" />
                        </div>
                        <div class="form-group">
                            <label>Statut *</label>
                            <InputSelect @bind-Value="currentFormation.Statut" class="form-input">
                                <option value="A venir">À venir</option>
                                <option value="En cours">En cours</option>
                                <option value="Terminée">Terminée</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => currentFormation.Statut)" />
                        </div>
                        <div class="form-group">
                            <label>Lieu *</label>
                            <InputText @bind-Value="currentFormation.Lieu" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.Lieu)" />
                        </div>
                        <div class="form-group">
                            <label>Partenaires</label>
                            <InputText @bind-Value="currentFormation.Partenaires" class="form-input" placeholder="Séparés par des virgules" />
                        </div>
                        <div class="form-group">
                            <label>Capacité max *</label>
                            <InputNumber @bind-Value="currentFormation.CapaciteMax" class="form-input" />
                            <ValidationMessage For="@(() => currentFormation.CapaciteMax)" />
                        </div>
                        <div class="form-group">
                            <label>
                                <InputCheckbox @bind-Value="currentFormation.InscriptionOuverte" />
                                Inscriptions ouvertes
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i> <text>Traitement en cours</text>
                            }
                            else
                            {
                                <i class="fas fa-save"></i> @(isEditing ? "Modifier" : "Créer")
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- MODAL INSCRIPTIONS -->
    @if (showInscriptionsModal && selectedFormation != null)
    {
        <div class="modal-overlay" @onclick="CloseInscriptionsModal">
            <div class="modal-content large" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Inscriptions - @selectedFormation.Titre</h2>
                    <button class="modal-close" @onclick="CloseInscriptionsModal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                @if (inscriptions == null)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Chargement des inscriptions...</p>
                    </div>
                }
                else if (inscriptions.Count == 0)
                {
                    <div class="empty-state">
                        <i class="fas fa-user-slash"></i>
                        <h3>Aucune inscription</h3>
                        <p>Cette formation n'a pas encore d'inscrits</p>
                    </div>
                }
                else
                {
                    <div class="inscriptions-list">
                        @foreach (var inscription in inscriptions)
                        {
                            <div class="inscription-item">
                                <div class="inscription-info">
                                    <div class="inscription-name">@inscription.Nom</div>
                                    <div class="inscription-contact">
                                        <i class="fas fa-envelope"></i> @inscription.Email
                                        <span class="separator">|</span>
                                        <i class="fas fa-phone"></i> @inscription.Telephone
                                    </div>
                                    <div class="inscription-date">
                                        <i class="fas fa-calendar"></i> @inscription.DateInscription.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                                <div class="inscription-status @GetInscriptionStatusClass(inscription.Statut)">
                                    @inscription.Statut
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</AuthGuard>

@code {
    private List<Formation>? formations;
    private List<Inscription>? inscriptions;
    private Formation? selectedFormation;
    private Formation currentFormation = new();
    private string searchQuery = "";
    private string statutFilter = "";
    private bool showModal = false;
    private bool showInscriptionsModal = false;
    private bool isEditing = false;
    private bool isSubmitting = false;
    private bool isUploadingImage = false;
    private string currentUsername = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadFormations();
        var (username, _, _) = await AuthService.GetCurrentUserAsync();
        currentUsername = username ?? "Admin";
    }

    private async Task LoadFormations()
    {
        formations = await Http.GetFromJsonAsync<List<Formation>>("api/formations");
    }

    private IEnumerable<Formation> FilteredFormations
    {
        get
        {
            if (formations == null) return Enumerable.Empty<Formation>();

            var query = formations.AsEnumerable();

            if (!string.IsNullOrEmpty(searchQuery))
            {
                query = query.Where(f => 
                    f.Titre.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    f.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    f.Lieu.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(statutFilter))
            {
                query = query.Where(f => f.Statut == statutFilter);
            }

            return query.OrderByDescending(f => f.DateDebut);
        }
    }

    private string GetStatusClass(string statut)
    {
        return statut switch
        {
            "En cours" => "status-en-cours",
            "A venir" => "status-avenir",
            "Terminée" => "status-terminee",
            _ => ""
        };
    }

    private string GetInscriptionStatusClass(string statut)
    {
        return statut switch
        {
            "Confirmée" => "status-confirmee",
            "En attente" => "status-attente",
            "Annulée" => "status-annulee",
            _ => ""
        };
    }

    private void ShowAddForm()
    {
        currentFormation = new Formation
        {
            DateDebut = DateTime.Today.AddDays(7),
            DateFin = DateTime.Today.AddDays(37),
            CapaciteMax = 20,
            InscriptionOuverte = true,
            Statut = "A venir"
        };
        isEditing = false;
        showModal = true;
    }

    private void EditFormation(Formation formation)
    {
        currentFormation = new Formation
        {
            Id = formation.Id,
            Titre = formation.Titre,
            Description = formation.Description,
            Prix = formation.Prix,
            DateDebut = formation.DateDebut,
            DateFin = formation.DateFin,
            Horaires = formation.Horaires,
            Statut = formation.Statut,
            Lieu = formation.Lieu,
            Partenaires = formation.Partenaires,
            InscriptionOuverte = formation.InscriptionOuverte,
            CapaciteMax = formation.CapaciteMax,
            PlacesRestantes = formation.PlacesRestantes,
            ImageUrl = formation.ImageUrl
        };
        isEditing = true;
        showModal = true;
    }

    private void RemoveFormationImage()
    {
        currentFormation.ImageUrl = null;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        isUploadingImage = true;
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var content = new MultipartFormDataContent();
                using var fileStream = file.OpenReadStream(maxAllowedSize: 5_000_000);
                using var streamContent = new StreamContent(fileStream);
                streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/formations/upload-image", content);

                if (response.IsSuccessStatusCode)
                {
                    var imageUrl = await response.Content.ReadAsStringAsync();
                    currentFormation.ImageUrl = imageUrl.Trim('"');
                    NotificationService.ShowSuccess("Image uploadée avec succès");
                }
                else
                {
                    NotificationService.ShowError("Erreur lors de l'upload de l'image");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload: {ex.Message}");
            NotificationService.ShowError("Erreur lors de l'upload de l'image");
        }
        finally
        {
            isUploadingImage = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            HttpResponseMessage response;

            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/formations/{currentFormation.Id}", currentFormation);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/formations", currentFormation);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess(isEditing ? "Formation modifiée avec succès" : "Formation créée avec succès");
                await LoadFormations();
                CloseModal();
            }
            else
            {
                NotificationService.ShowError("Une erreur s'est produite");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Erreur: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteFormation(Formation formation)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer la formation \"{formation.Titre}\" ?");
        if (!confirmed)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/formations/{formation.Id}");
            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess("Formation supprimée avec succès");
                await LoadFormations();
            }
            else
            {
                NotificationService.ShowError("Une erreur s'est produite");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Erreur: {ex.Message}");
        }
    }

    private async Task ViewInscriptions(Formation formation)
    {
        selectedFormation = formation;
        inscriptions = await Http.GetFromJsonAsync<List<Inscription>>($"api/formations/{formation.Id}/inscriptions");
        showInscriptionsModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        currentFormation = new Formation();
    }

    private void CloseInscriptionsModal()
    {
        showInscriptionsModal = false;
        selectedFormation = null;
        inscriptions = null;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }
}

<style>
