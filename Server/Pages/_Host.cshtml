@page "/"
@namespace ETechEnergie.Server.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ETech Énergie - Solutions Solaire & Formations</title>
    <base href="/" />
    
    <!-- Meta tags par défaut pour les crawlers statiques -->
    <meta name="description" content="ETech Énergie : Votre associé en installations solaires et domestiques ainsi qu'en formations relatives aux professions de la transition énergétique et à la vente de matériels électroniques." />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content="ETech Énergie" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://etechenergie.onrender.com/android-chrome-512x512.png" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="ETechEnergie.Client.styles.css" />
    <link rel="icon" type="image/png" href="favicon-32x32.png" />
    
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="WebAssemblyPrerendered" />
</head>
<body>
    <div id="app">
        <component type="typeof(ETechEnergie.Client.App)" render-mode="WebAssemblyPrerendered" />
    </div>

    <div id="blazor-error-ui">
        Une erreur est survenue.
        <a href="" class="reload">Recharger</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.webassembly.js"></script>
</body>
</html>
